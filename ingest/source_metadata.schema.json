{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/radarsaint/bfdm-corpus/ingest/source_metadata.schema.json",
  "title": "BFDM source container metadata",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "project",
    "project_slug",
    "title",
    "source_role",
    "source_kind",
    "authorship",
    "locators",
    "representations",
    "normalization",
    "capture_status",
    "ingested_at"
  ],
  "properties": {
    "schema_version": {
      "const": "bfdm_source_metadata/v1"
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^BCS-[0-9]{6}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "project_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_role": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "type": "string",
      "minLength": 1
    },
    "document_family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_filename": {
      "type": [
        "string",
        "null"
      ]
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "modified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingested_at": {
      "type": "string",
      "minLength": 1
    },
    "authorship": {
      "type": "object",
      "required": [
        "status",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "BRENDON",
            "COLLABORATIVE",
            "OTHER_AUTHOR",
            "UNKNOWN"
          ]
        },
        "basis": {
          "type": "string"
        },
        "project_ownership_context": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "provider",
          "locator_type"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "locator_type": {
            "type": "string",
            "minLength": 1
          },
          "native_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "library_file_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_file_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "version_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "representations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "mime_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "provider_revision_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "normalization": {
      "type": "object",
      "required": [
        "method",
        "warnings"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "capture_status": {
      "type": "object",
      "required": [
        "current_body",
        "comments",
        "revision_metadata",
        "revision_bodies",
        "assets"
      ],
      "properties": {
        "current_body": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        },
        "revision_metadata": {
          "type": "string"
        },
        "revision_bodies": {
          "type": "string"
        },
        "assets": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "historical_context": {
      "type": "object",
      "properties": {
        "project_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "project_id",
              "relation",
              "confidence",
              "basis",
              "support_refs"
            ],
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "enum": [
                  "BELONGS_TO_PROJECT",
                  "RELATES_TO_PROJECT",
                  "CROSS_PROJECT"
                ]
              },
              "confidence": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "support_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "production_stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "confidence",
              "basis",
              "support_refs"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "RESEARCH_INSPIRATION",
                  "BRAINSTORMING",
                  "PREPRODUCTION",
                  "SYSTEM_DEVELOPMENT",
                  "CAMPAIGN_OPERATIONS",
                  "LIVE_USE_ARTIFACT",
                  "PUBLIC_PLAYER_FACING_PUBLICATION",
                  "POSTMORTEM_CORRECTION",
                  "LATER_RETROSPECTIVE"
                ]
              },
              "confidence": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "support_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "link_type",
          "target_kind",
          "confidence",
          "basis",
          "support_refs"
        ],
        "properties": {
          "link_type": {
            "enum": [
              "VERSION_OF",
              "PREDECESSOR_OF",
              "SUCCESSOR_OF",
              "REVISES",
              "SUPERSEDES",
              "PUBLISHED_AS",
              "DEV_PUBLIC_PAIR",
              "DERIVED_FROM",
              "COPIED_REPRESENTATION_OF",
              "RESPONDS_TO",
              "COMPANION_TO",
              "IMPLEMENTED_IN",
              "DISCUSSED_DURING",
              "ALTERED_DURING_PLAY",
              "ABANDONED_BEFORE_PLAY",
              "OUTCOME_DOCUMENTED_IN",
              "REVISION_CONTEXT_FOR_SOURCE_FAMILY",
              "SOURCE_VERSION_FAMILY_MEMBER"
            ]
          },
          "target_kind": {
            "enum": [
              "SOURCE",
              "DISCORD_MESSAGE",
              "DISCORD_CHANNEL",
              "DISCORD_SERVER",
              "EXTERNAL_SOURCE",
              "RESEARCH_RECORD"
            ]
          },
          "to_corpus_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^BCS-[0-9]{6}$"
          },
          "external_locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "support_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
