{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"863371194371801118","content":"\"I guess I've just been too busy. Unless it was like 2 days ago, I was not in my best health at the time was having sort of a\" he mimics a hand movement of his hand crawling onto his fist and then making the brain explosion gesture","created_at":"2021-07-26T03:17:47.348000Z","edited_at":null,"id":"869055876974120962","reply_to_id":null,"thread":null,"thread_id":null}
