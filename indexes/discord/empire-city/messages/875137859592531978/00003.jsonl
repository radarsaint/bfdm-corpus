{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"875137859592531978","content":"\"I say we use taxes to fund private armies and police forces. So that they can act independently of our government with out  the government getting blamed. The corperations can take care of it. World Peace (TM) by Vanderbilt.\"","created_at":"2021-08-12T23:38:14.278000Z","edited_at":null,"id":"875523606694744146","reply_to_id":null,"thread":null,"thread_id":null}
