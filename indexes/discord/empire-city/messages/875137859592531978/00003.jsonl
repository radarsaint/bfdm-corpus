{"attachments":[],"author":{"display_name":"unashaminglyme","id":"340062533304057857","is_bot":0,"username":"unashaminglyme"},"author_id":"340062533304057857","channel_id":"875137859592531978","content":"\"Why are we so quick to dismiss religion and matters of gods? You say gods have their own agendas, but do people not have agendas themselves? And you wish to grant all people power and representation.\" The speaker ignores Irynx's words.","created_at":"2021-08-13T01:58:33.077000Z","edited_at":"2021-08-13T01:58:44.883000Z","id":"875558917697064970","reply_to_id":null,"thread":null,"thread_id":null}
