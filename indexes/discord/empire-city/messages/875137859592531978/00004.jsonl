{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"875137859592531978","content":"\"Their not gods.\" Cassie pipes up again.","created_at":"2021-08-13T02:58:31.112000Z","edited_at":null,"id":"875574008949645312","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"875137859592531978","content":"\"A higher being then.\"","created_at":"2021-08-13T02:58:45.995000Z","edited_at":null,"id":"875574071373471765","reply_to_id":null,"thread":null,"thread_id":null}
