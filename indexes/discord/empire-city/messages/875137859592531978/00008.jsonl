{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"875137859592531978","content":"\"I am well enough. Just passing through, and we heard that history was being made. Never miss a chance to watch history.\"","created_at":"2021-08-14T01:24:27.985000Z","edited_at":null,"id":"875912727825100810","reply_to_id":null,"thread":null,"thread_id":null}
