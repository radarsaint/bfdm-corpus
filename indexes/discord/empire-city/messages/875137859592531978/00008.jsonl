{"attachments":[],"author":{"display_name":"Basil","id":"339235123759153162","is_bot":0,"username":"divinedefault"},"author_id":"339235123759153162","channel_id":"875137859592531978","content":"\"I don't support this as is. maybe you can convince me later. but there's many pitfalls that you can only pray to whatever you believe people don't fall into.","created_at":"2021-08-13T19:06:36.087000Z","edited_at":null,"id":"875817634992627823","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"875137859592531978","content":"\"I recognize your choice and leave you to that. There shall be a small amendment to wording of officers regarding religious influence, but if the form of the rest and compromises added from your arguments are not sufficient, then I am afraid the fundament of the governing hitting the railings and being kept in check by the the system will not convince you in any form. I thank you for your inputs any how as they have indeed guided the creation of several lines\"","created_at":"2021-08-13T19:11:02.633000Z","edited_at":null,"id":"875818752967573544","reply_to_id":null,"thread":null,"thread_id":null}
