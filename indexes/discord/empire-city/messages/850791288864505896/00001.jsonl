{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"850791288864505896","content":"\"What? The ravens. Well. Yes I suppose we've all been once or twice. Though no one can ever exactly say why, can they?\"","created_at":"2021-07-11T09:01:45.758000Z","edited_at":null,"id":"863706622755733504","reply_to_id":null,"thread":null,"thread_id":null}
