{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"850791288864505896","content":"\"Well, yes. That's what I said. I've been.\"","created_at":"2021-07-11T09:04:05.365000Z","edited_at":null,"id":"863707208311111690","reply_to_id":null,"thread":null,"thread_id":null}
