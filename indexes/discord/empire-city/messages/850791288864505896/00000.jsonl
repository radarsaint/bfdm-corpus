{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"850791288864505896","content":"\"How grisly, to be denied even the life given a shadow. Would I be correct in presuming the murderers destroyed or hid their sentimental objects?\"","created_at":"2021-07-10T22:55:00.531000Z","edited_at":null,"id":"863553928166375424","reply_to_id":null,"thread":null,"thread_id":null}
