{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"850791288864505896","content":"\"Well, it was them Clutter family. The whole lot, all four of them. Awful really, what happened.\"","created_at":"2021-07-10T22:51:06.658000Z","edited_at":null,"id":"863552947232964691","reply_to_id":null,"thread":null,"thread_id":null}
