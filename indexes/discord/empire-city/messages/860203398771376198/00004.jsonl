{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860203398771376198","content":"\"No. They are mine to trade to their owner.\"","created_at":"2021-07-28T04:32:09.236000Z","edited_at":null,"id":"869799367220006932","reply_to_id":null,"thread":null,"thread_id":null}
