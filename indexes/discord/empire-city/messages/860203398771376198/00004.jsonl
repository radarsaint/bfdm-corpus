{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860203398771376198","content":"\"As do you, and all of the other dead.\"","created_at":"2021-07-28T04:30:20.590000Z","edited_at":null,"id":"869798911525683220","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Plague","id":"476553068687654922","is_bot":0,"username":"__plague"},"author_id":"476553068687654922","channel_id":"860203398771376198","content":"\"Oh,\" Mictlan looks interested. \"I did not know that. Thank you.\"","created_at":"2021-07-28T04:31:05.191000Z","edited_at":null,"id":"869799098595815436","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860203398771376198","content":"\"I am patient. And the only way to eat the worlds is one bite at a time.\"","created_at":"2021-07-28T04:31:12.226000Z","edited_at":null,"id":"869799128102760538","reply_to_id":null,"thread":null,"thread_id":null}
