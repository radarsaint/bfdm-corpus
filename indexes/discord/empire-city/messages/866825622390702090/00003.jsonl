{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"866825622390702090","content":"(damn you i was typing that)","created_at":"2021-07-25T00:22:18.312000Z","edited_at":null,"id":"868649327130710016","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"866825622390702090","content":"\"I can never thank you enough. You've been so nice to me, even when I was cursed. And you gave up some of your life for me to have this body back.\"","created_at":"2021-07-25T00:24:00.774000Z","edited_at":null,"id":"868649756887498762","reply_to_id":null,"thread":null,"thread_id":null}
