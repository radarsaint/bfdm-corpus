{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"866825622390702090","content":"\"Just me,\" Irynx opens up the door. \"Speaker went to rest in Ferrytown, I believe.\"","created_at":"2021-07-24T23:18:20.442000Z","edited_at":null,"id":"868633229937213500","reply_to_id":null,"thread":null,"thread_id":null}
