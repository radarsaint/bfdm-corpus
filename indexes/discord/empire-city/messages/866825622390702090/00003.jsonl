{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"866825622390702090","content":"(closer to spring)","created_at":"2021-07-25T00:19:46.435000Z","edited_at":null,"id":"868648690112397343","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"866825622390702090","content":"\"You have me as a friend because, you do! And I don't care what you deserve.\" She stands up and places another kiss on Willow's forehead.","created_at":"2021-07-25T00:19:49.788000Z","edited_at":"2021-07-25T16:12:48.550000Z","id":"868648704175910962","reply_to_id":null,"thread":null,"thread_id":null}
