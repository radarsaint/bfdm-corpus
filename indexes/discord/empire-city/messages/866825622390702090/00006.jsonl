{"attachments":[],"author":{"display_name":"ArcaniaBot","id":"810907841329627137","is_bot":1,"username":"ArcaniaBot"},"author_id":"810907841329627137","channel_id":"866825622390702090","content":"<@366565198284324868> Good night! You'll get a ping when your 8 hours pass.","created_at":"2021-08-19T13:16:56.587000Z","edited_at":null,"id":"877903967785480283","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"866825622390702090","content":"Iryne turns back into an owlfolk and flops onto the bed, quick to fall asleep.","created_at":"2021-08-19T13:17:23.235000Z","edited_at":null,"id":"877904079555284993","reply_to_id":null,"thread":{"archived":1,"channel_id":"866825622390702090","created_at":"2021-07-29T16:33:20.331000Z","id":"870343247212453929","name":"irynxs-quarters"},"thread_id":"870343247212453929"}
{"attachments":[],"author":{"display_name":"unashaminglyme","id":"340062533304057857","is_bot":0,"username":"unashaminglyme"},"author_id":"340062533304057857","channel_id":"866825622390702090","content":"\"I'll try my best, we'll all try our best. War is truly a dreadful thing.\" The Speaker says before moving towards the pilot's helm. He closes his eyes and dreams of a world unburdened by war. He'll settle with dreams for now.","created_at":"2021-08-19T13:19:41.001000Z","edited_at":null,"id":"877904657387761735","reply_to_id":null,"thread":null,"thread_id":null}
