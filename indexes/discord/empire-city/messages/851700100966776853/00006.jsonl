{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"Return the child, stop the attacks. Simple enough, if it works.\"","created_at":"2021-07-18T07:59:36.664000Z","edited_at":null,"id":"866227696861970443","reply_to_id":null,"thread":null,"thread_id":null}
