{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"851700100966776853","content":"\"I'll be honest, I'm still a bit rusty after a few months without a bow.\"","created_at":"2021-07-18T10:34:22.702000Z","edited_at":null,"id":"866266645328035840","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"851700100966776853","content":"Sabrine stamps the staff on the ground, and a daisy grows from it.","created_at":"2021-07-18T10:34:32.685000Z","edited_at":null,"id":"866266687200034816","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"I saw what you could do Roy. I cannot say I am unimpressed.\"","created_at":"2021-07-18T10:34:53.750000Z","edited_at":null,"id":"866266775553441823","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"851700100966776853","content":"'I... week. But... Cold be, rel-eated... Me' she glances at Roy, gesturing for him to explain if needed.","created_at":"2021-07-18T10:35:24.041000Z","edited_at":null,"id":"866266902602842172","reply_to_id":null,"thread":null,"thread_id":null}
