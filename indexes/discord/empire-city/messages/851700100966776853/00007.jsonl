{"attachments":[{"content_type":"image/jpeg","filename":"radiant_bunny.jpg","id":"866238594263023666","local_path":"discord/empire-city/attachments/851700100966776853/866238594263023666-radiant_bunny.jpg","message_id":"866238594499084318","sha256":"a8036767b247bab8cca2236316e1f2c55cae829e1818939bbd277a665db075d5","size":340100,"url":"https://cdn.discordapp.com/attachments/851700100966776853/866238594263023666/radiant_bunny.jpg?ex=6ac0c00e&is=6abf6e8e&hm=a0074805d7aa386aa1a055a0b1b5f2d6d5d3b94e439bf888c5ac374c9767f2e5&"}],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"","created_at":"2021-07-18T08:42:54.863000Z","edited_at":null,"id":"866238594499084318","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"(OH MY GOD SO CUTE)","created_at":"2021-07-18T08:43:06.797000Z","edited_at":null,"id":"866238644553646111","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"Fight fears so that I might grow. You are my hope, and I am yours.\"","created_at":"2021-07-18T08:44:00.277000Z","edited_at":null,"id":"866238868863582208","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"\"And whom might you be?\"","created_at":"2021-07-18T08:44:22.479000Z","edited_at":"2021-07-18T08:45:30.305000Z","id":"866238961987092500","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"The Noir contains both hope and the absence of hope. Me and mine are needed now.\"","created_at":"2021-07-18T08:45:20.365000Z","edited_at":null,"id":"866239204777656341","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"Apgan places his shield on the ground as a platform for the creature to rest on, if it wishes.","created_at":"2021-07-18T08:45:20.497000Z","edited_at":null,"id":"866239205331566592","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"Hope lands on Apgan's sheild. It gives a faint glow (light cast on shield for 24 hours.)","created_at":"2021-07-18T08:46:12.066000Z","edited_at":"2021-07-18T08:46:34.232000Z","id":"866239421627891713","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"Apgan beams.","created_at":"2021-07-18T08:46:34.125000Z","edited_at":null,"id":"866239514149388289","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"\"How may I be of service to you\" A smile creeps over Johnathan's face","created_at":"2021-07-18T08:46:53.083000Z","edited_at":null,"id":"866239593665396746","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"We are to find and face the fears that haunt this place, it would seem.\"","created_at":"2021-07-18T08:47:10.573000Z","edited_at":null,"id":"866239667023118387","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"Defeating the fears of the waste will allow us to help guard the resolve of the Empire of Refuge.\"","created_at":"2021-07-18T08:48:32.800000Z","edited_at":null,"id":"866240011909332992","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"\"Then that is what I must do\"","created_at":"2021-07-18T08:49:08.237000Z","edited_at":null,"id":"866240160542097448","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"Simply tell where we might find these fears. I have courage to spare.\"","created_at":"2021-07-18T08:50:00.151000Z","edited_at":null,"id":"866240378285588490","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"The Noir is the cast off emotions. The invasive thoughts that strike for no reason unbidden. That which assaults us and accuses us of our past mistakes. The memories of possessions. Beyond the lamp light.\"","created_at":"2021-07-18T08:50:48.249000Z","edited_at":null,"id":"866240580022304798","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"Apgan nods. <#850806376740945952> , then.","created_at":"2021-07-18T08:51:36.735000Z","edited_at":null,"id":"866240783387459594","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"There is much danger. But hope can offer you this. A stone of humility.\"","created_at":"2021-07-18T08:51:45.393000Z","edited_at":null,"id":"866240819701481483","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"This will protect you once per day from being drained of a color.\"","created_at":"2021-07-18T08:52:13.336000Z","edited_at":null,"id":"866240936903049216","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"I can impart one each to the two of you.","created_at":"2021-07-18T08:52:28.957000Z","edited_at":null,"id":"866241002423189504","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"\"Thank you kind creature\" Johnathan will take the stone and begin to follow Apgan","created_at":"2021-07-18T08:52:55.709000Z","edited_at":null,"id":"866241114628554762","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"Apgan will kneel before Hope, and hold his hand out, awash in gratefulness.","created_at":"2021-07-18T08:52:56.373000Z","edited_at":"2021-07-18T08:53:13.267000Z","id":"866241117414096926","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"Know this. The Noir is an intentional bleed of positive and negative ley lines.\"","created_at":"2021-07-18T08:53:45.932000Z","edited_at":null,"id":"866241325279084565","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"\"Then it is in it's nature to be in conflict with itself\"","created_at":"2021-07-18T08:54:25.365000Z","edited_at":null,"id":"866241490674384916","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"These creatures, these fears--must they only know violence? There was a child...I slew it.\"","created_at":"2021-07-18T08:54:50.995000Z","edited_at":null,"id":"866241598172692480","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"I wished to embrace it, in its pain and fear, but I knew its power too well.\"","created_at":"2021-07-18T08:55:21.189000Z","edited_at":null,"id":"866241724816818186","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"Was that weakness? To condemn that which suffered?\"","created_at":"2021-07-18T08:56:02.419000Z","edited_at":null,"id":"866241897747447808","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"Johnathan's face darkens as he hears this, but in a somber way, as if he is familiar with the nature of the conflict","created_at":"2021-07-18T08:56:06.199000Z","edited_at":null,"id":"866241913602310144","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"Apgan takes in Hope's silence.","created_at":"2021-07-18T08:57:54.980000Z","edited_at":null,"id":"866242369862762536","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"When all is black and white. When the entropy of perspective ceases and the chaos of the heart is allowed to reign free. The weakness is both in the stagnation of perspective. The weakness is in the chaos of the heart. Your mind saw danger and your heart saw mercy. You are in balance. This is wisdom and control. You have done well upon the inscrutable face of abandonment.\"","created_at":"2021-07-18T08:58:31.712000Z","edited_at":"2021-07-18T08:58:53.418000Z","id":"866242523928461313","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"Thank you.\"","created_at":"2021-07-18T08:59:10.833000Z","edited_at":null,"id":"866242688012255263","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"Johnathan. We are called to the noir. Are you prepared to go, in the name of hope?\"","created_at":"2021-07-18T08:59:56.787000Z","edited_at":null,"id":"866242880757956608","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"Seek you the corner stone of the city. It lies in Hampstead. Find it and set it upon the heart of those around you. Cary it forth and I will follow you all of your days.\"","created_at":"2021-07-18T09:00:30.127000Z","edited_at":null,"id":"866243020596969472","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"\"Yes, there is no more nobler a name to fight for\"","created_at":"2021-07-18T09:00:47.975000Z","edited_at":null,"id":"866243095455596544","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"Prepare your mind, and marshal what forces you can. Strong as you may be, it would be fool hardy to enter with out friends both true and strong.\"","created_at":"2021-07-18T09:01:23.826000Z","edited_at":null,"id":"866243245827031041","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"Sabrine would be awake. Roy, perhaps.\"","created_at":"2021-07-18T09:01:59.673000Z","edited_at":null,"id":"866243396178673664","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"\"Then should we gather what allies we can, do you know where they may be?\"","created_at":"2021-07-18T09:02:33.407000Z","edited_at":null,"id":"866243537669980170","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851700100966776853","content":"\"Seek you the cornerstone.\" Hope says as she softly glides away.","created_at":"2021-07-18T09:02:50.835000Z","edited_at":null,"id":"866243610768965633","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"\"Since her resurrection, Sabrine has spent many hours in <#861700807626588220> \"","created_at":"2021-07-18T09:04:06.316000Z","edited_at":null,"id":"866243927359488050","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851700100966776853","content":"\"Then we should check there first\" Johnathan will follow Apgan wherever he decides to go","created_at":"2021-07-18T09:05:18.164000Z","edited_at":null,"id":"866244228710268948","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"851700100966776853","content":"<@!148682928434577408>  <@!150319814836092928> <@!859432639681134592> and <@!185916549066915852> all arrive, in the name of hope.","created_at":"2021-07-18T09:32:28.227000Z","edited_at":null,"id":"866251065690947614","reply_to_id":null,"thread":null,"thread_id":null}
