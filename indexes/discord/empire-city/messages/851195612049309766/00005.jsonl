{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851195612049309766","content":"\"Yes, it is something that would be better discussed over drinks. Well I'll meet you there\" Jonathan begins to walk, somewhat somberly towards <#851195363888201749>","created_at":"2021-07-19T22:01:03.952000Z","edited_at":null,"id":"866801843761446973","reply_to_id":null,"thread":null,"thread_id":null}
