{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"851195612049309766","content":"\"A pleasure to meet you all.\"\n\n\"Well Apgan, they seem to have one out for you. Be careful around redcoats in this area, especially if they're in sight of a poster.\" he says when Aljarad is retrieving tea in the other room","created_at":"2021-07-12T18:53:42.870000Z","edited_at":null,"id":"864217980186918912","reply_to_id":null,"thread":null,"thread_id":null}
