{"attachments":[],"author":{"display_name":"StarPilot94","id":"468162764586876949","is_bot":0,"username":"starpilot94"},"author_id":"468162764586876949","channel_id":"851195612049309766","content":"Secel just kinda shows up somehow. Irl Secel just kinda doesnt care about it anymore so fuck it. She begins work on cleaning up.","created_at":"2021-08-22T08:36:44.596000Z","edited_at":null,"id":"878920616781168641","reply_to_id":null,"thread":null,"thread_id":null}
