{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"850806376740945952","content":"\"Thats what I am, yes.\"","created_at":"2021-07-29T03:01:33.054000Z","edited_at":null,"id":"870138954085728307","reply_to_id":null,"thread":null,"thread_id":null}
