{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"863470940183724082","content":"\"Good idea.\"","created_at":"2021-08-08T17:18:17.002000Z","edited_at":null,"id":"873978436526420010","reply_to_id":null,"thread":null,"thread_id":null}
