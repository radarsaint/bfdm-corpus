{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"863470940183724082","content":"\"You don't have that wording over here? How about 'in her honor' instead?\"","created_at":"2021-08-08T16:56:12.583000Z","edited_at":null,"id":"873972881510527036","reply_to_id":null,"thread":null,"thread_id":null}
