{"attachments":[],"author":{"display_name":"BenevolentDM","id":"470420431841656833","is_bot":0,"username":"benevolentdm"},"author_id":"470420431841656833","channel_id":"868223304513761301","content":"Malathor pauses a moment, and then turns, holding a lit taper stick, a wide smile on his face. \"Then light the candles Bo, the hour of your ascension is upon us...\"","created_at":"2021-07-25T17:30:24.929000Z","edited_at":null,"id":"868908059555160075","reply_to_id":null,"thread":null,"thread_id":null}
