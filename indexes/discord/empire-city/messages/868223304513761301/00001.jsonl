{"attachments":[],"author":{"display_name":"BenevolentDM","id":"470420431841656833","is_bot":0,"username":"benevolentdm"},"author_id":"470420431841656833","channel_id":"868223304513761301","content":"\"This is your last chance, are you *prepared* to go through with this ritual, to obtain the power you so wished to possess before in the park?\" Malathor speaks without turning around.","created_at":"2021-07-25T17:26:08.026000Z","edited_at":null,"id":"868906982025855036","reply_to_id":null,"thread":null,"thread_id":null}
