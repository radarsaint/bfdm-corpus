{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"868223304513761301","content":"Bo holds his hand out extending his pinky finger.","created_at":"2021-07-25T18:22:48.721000Z","edited_at":null,"id":"868921245574512660","reply_to_id":null,"thread":null,"thread_id":null}
