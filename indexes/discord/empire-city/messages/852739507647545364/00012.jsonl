{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"852739507647545364","content":"\"You don't need to be someone you're not.\"","created_at":"2021-08-06T10:48:01.910000Z","edited_at":null,"id":"873155450781175838","reply_to_id":null,"thread":null,"thread_id":null}
