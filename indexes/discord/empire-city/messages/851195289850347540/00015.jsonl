{"attachments":[],"author":{"display_name":"Gor-eal","id":"859432639681134592","is_bot":0,"username":"gorealthundhal"},"author_id":"859432639681134592","channel_id":"851195289850347540","content":"\"Oh no, Mr. Wrask is just fine, I still have yet to arise to the title of Knight. Where might you be from by the way?\"","created_at":"2021-07-13T17:54:19.709000Z","edited_at":null,"id":"864565423071690763","reply_to_id":null,"thread":null,"thread_id":null}
