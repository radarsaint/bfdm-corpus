{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"851195289850347540","content":"Bo shakes his head. \"Nah, not here, used ta patrol my homelands many moon ago.\"","created_at":"2021-07-27T10:15:15.900000Z","edited_at":null,"id":"869523326081597490","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851195289850347540","content":"\"I walk from house to house tapping on bedroom windows to wake folks up. 5 copper a morning per customer per day. Its a fair bit of coin for those of us who can be counted on to be prompt and regular.\"","created_at":"2021-07-27T10:16:08.210000Z","edited_at":null,"id":"869523545485619200","reply_to_id":null,"thread":null,"thread_id":null}
