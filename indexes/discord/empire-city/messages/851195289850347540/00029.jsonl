{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"851195289850347540","content":"Bo sits down near the lad. \"I aint seen you 'round here before. What brings you out tonight?\" He begins eating hastily.","created_at":"2021-07-27T10:11:49.005000Z","edited_at":null,"id":"869522458301059092","reply_to_id":null,"thread":null,"thread_id":null}
