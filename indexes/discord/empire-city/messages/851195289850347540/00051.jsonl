{"attachments":[],"author":{"display_name":"BenevolentDM","id":"470420431841656833","is_bot":0,"username":"benevolentdm"},"author_id":"470420431841656833","channel_id":"851195289850347540","content":"\"Would there be... drawbacks?\" *The man asks still holding the vampires hand.*","created_at":"2021-08-28T06:02:31.634000Z","edited_at":null,"id":"881056134239256617","reply_to_id":null,"thread":null,"thread_id":null}
