{"attachments":[],"author":{"display_name":"BenevolentDM","id":"470420431841656833","is_bot":0,"username":"benevolentdm"},"author_id":"470420431841656833","channel_id":"851195289850347540","content":"\"Ah! Good morning my appprentice, Mr. Apgan. I see my new apprentice is not accompanying you...\" Malathor says leaning on his scepter.","created_at":"2021-07-25T16:40:09.211000Z","edited_at":null,"id":"868895410717077544","reply_to_id":null,"thread":null,"thread_id":null}
