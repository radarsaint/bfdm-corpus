{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"851195289850347540","content":"'Or does... it respond to... anything?'","created_at":"2021-07-16T10:05:26.716000Z","edited_at":null,"id":"865534588343549992","reply_to_id":null,"thread":null,"thread_id":null}
