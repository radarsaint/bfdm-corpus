{"attachments":[],"author":{"display_name":"BenevolentDM","id":"470420431841656833","is_bot":0,"username":"benevolentdm"},"author_id":"470420431841656833","channel_id":"851195289850347540","content":"\"Ah, the basement, yes, just a... *project*, me and an associate of mine were working on. Likely destroyed in the attack however...\" Malathor nods sadly. \"Now, onto the topic of a reward...\"","created_at":"2021-07-16T10:04:52.998000Z","edited_at":null,"id":"865534446919745536","reply_to_id":null,"thread":null,"thread_id":null}
