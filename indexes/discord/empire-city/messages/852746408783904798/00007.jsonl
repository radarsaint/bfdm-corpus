{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"852746408783904798","content":"\"I've come to your Cafe on a recommendation, I was wondering if you're still open?\"","created_at":"2021-08-24T03:31:57.492000Z","edited_at":null,"id":"879568690838908939","reply_to_id":null,"thread":null,"thread_id":null}
