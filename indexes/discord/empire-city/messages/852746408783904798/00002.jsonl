{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"852746408783904798","content":"\"That kid calling me mom got me thinking... I don't know anything about parenting...\"","created_at":"2021-07-19T19:11:15.354000Z","edited_at":null,"id":"866759109684232222","reply_to_id":null,"thread":null,"thread_id":null}
