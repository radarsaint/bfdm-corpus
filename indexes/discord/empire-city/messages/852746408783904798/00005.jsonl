{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"852746408783904798","content":"'Blueberries, huh...' she concentrates, and creates ten goodberries, bluer than her normal ones. she holds five of them out to Prosser, and gives the other five to Kukudh, who flies off.","created_at":"2021-08-19T09:20:45.443000Z","edited_at":null,"id":"877844529699487796","reply_to_id":null,"thread":null,"thread_id":null}
