{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"852746408783904798","content":"\"Yes. What do you imagine the trees find from Trapero?\"","created_at":"2021-08-19T09:17:52.185000Z","edited_at":null,"id":"877843803002798091","reply_to_id":null,"thread":null,"thread_id":null}
