{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"852746408783904798","content":"\"Sillier question then.\"","created_at":"2021-08-19T09:12:27.208000Z","edited_at":null,"id":"877842439950454794","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"852746408783904798","content":"\"What do you think the trees taste?\"\n\n\"In the sea, we still believed in burying our dead where the trees can drink. My mother always said they would taste the ocean in me.\"","created_at":"2021-08-19T09:15:07.408000Z","edited_at":"2021-08-19T10:01:21.771000Z","id":"877843111877951488","reply_to_id":null,"thread":null,"thread_id":null}
