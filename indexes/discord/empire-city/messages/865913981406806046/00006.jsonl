{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"865913981406806046","content":"\"I've heard going on with the mender and you as well\"","created_at":"2021-07-27T07:05:49.274000Z","edited_at":null,"id":"869475650996666408","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"865913981406806046","content":"\"I've got a man name Slim who passes me notes in the Samuel Addams. Its the quickest way to get a message to my workshop.\"","created_at":"2021-07-27T07:06:55.930000Z","edited_at":null,"id":"869475930572210216","reply_to_id":null,"thread":null,"thread_id":null}
