{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"865913981406806046","content":"\"Though having enough ~~plutonium to generate 1.21 jigawatts~~ to generate some electricity for my next experiment would be useful. Scientifically speaking.\" Ben Franklin is not about to look a gift horse in the mouth.","created_at":"2021-07-27T07:01:44.130000Z","edited_at":null,"id":"869474622788222977","reply_to_id":null,"thread":null,"thread_id":null}
