{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"865913981406806046","content":"\"Once you are finished here, I will be more than happy to tell you. Until you pass this final screening, I cannot divulge any secrets.\"","created_at":"2021-07-23T19:55:08.071000Z","edited_at":null,"id":"868219703561175061","reply_to_id":null,"thread":null,"thread_id":null}
