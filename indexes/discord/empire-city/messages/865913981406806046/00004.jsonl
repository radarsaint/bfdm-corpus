{"attachments":[],"author":{"display_name":"StarPilot94","id":"468162764586876949","is_bot":0,"username":"starpilot94"},"author_id":"468162764586876949","channel_id":"865913981406806046","content":"\"Yes, but that doesn't answer my question.\" The tone hardens slightly.","created_at":"2021-07-23T21:58:52.281000Z","edited_at":null,"id":"868250842954870795","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"865913981406806046","content":"\"Ipra is watching them. Not because they are a threat or in danger, but because they have been recommended as recruits to us and we wish to ensure inviting them to join will not compromise us.\"","created_at":"2021-07-23T22:02:21.369000Z","edited_at":null,"id":"868251719933501511","reply_to_id":null,"thread":null,"thread_id":null}
