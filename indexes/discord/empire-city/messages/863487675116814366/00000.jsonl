{"attachments":[],"author":{"display_name":"Bonafide Bone","id":"467139287192829977","is_bot":0,"username":".bonafidebone"},"author_id":"467139287192829977","channel_id":"863487675116814366","content":"he spits","created_at":"2021-07-10T19:15:35.573000Z","edited_at":null,"id":"863498710330900500","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"863487675116814366","content":"\"Oh heavens no.  I quite like following the god that i want without being pressed into service of another.\" he pauses and then continues \"so, as you may know, payment in this place is  not generally based on coin, but instead based on things of value.  So this list might seem odd.\"","created_at":"2021-07-10T19:17:01.465000Z","edited_at":null,"id":"863499070588059658","reply_to_id":null,"thread":null,"thread_id":null}
