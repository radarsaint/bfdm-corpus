{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"851195659985485844","content":"\"An arm and a leg I suppose, and probably specifically one's own.\"","created_at":"2021-07-12T07:32:47.752000Z","edited_at":null,"id":"864046621402988564","reply_to_id":null,"thread":null,"thread_id":null}
