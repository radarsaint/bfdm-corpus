{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"850786156479119391","content":"\"I don't like to hear that kind of talk. *Fight*.\"","created_at":"2021-08-20T12:16:04.857000Z","edited_at":null,"id":"878251039185317919","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"StarPilot94","id":"468162764586876949","is_bot":0,"username":"starpilot94"},"author_id":"468162764586876949","channel_id":"850786156479119391","content":"“No. When they were in my body, using me as their vessel when I let them, I was dying. And not in the way that would allow me to be brought back. It’s a death of everything, body and soul. How i got out with as little change is impossible for me to comprehend.”","created_at":"2021-08-20T12:16:47.559000Z","edited_at":null,"id":"878251218290499634","reply_to_id":null,"thread":null,"thread_id":null}
