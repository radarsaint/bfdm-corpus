{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"880392907335548988","content":"'Aren't carriages... normally on land?'","created_at":"2021-08-26T16:44:49.749000Z","edited_at":null,"id":"880492999077945354","reply_to_id":null,"thread":null,"thread_id":null}
