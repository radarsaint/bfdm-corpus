{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"880392907335548988","content":"\"We should have those extradimensional quarters. But stuff like your backpack, Roy, probably shouldn't be kept there.\"","created_at":"2021-08-26T17:06:52.061000Z","edited_at":null,"id":"880498545256456193","reply_to_id":null,"thread":null,"thread_id":null}
