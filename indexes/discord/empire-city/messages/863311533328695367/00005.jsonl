{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"863311533328695367","content":"\"You must be pretty powerful, too, huh?\"","created_at":"2021-07-24T22:40:15.231000Z","edited_at":null,"id":"868623645067579404","reply_to_id":null,"thread":null,"thread_id":null}
