{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"863743873411317800","content":"`My head is the perfect size for my body, thank you very much.` He struts around wearing the hat that blocks his sense of sight.","created_at":"2021-08-23T08:12:45.245000Z","edited_at":null,"id":"879276967571095553","reply_to_id":null,"thread":null,"thread_id":null}
