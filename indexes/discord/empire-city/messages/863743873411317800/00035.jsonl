{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"863743873411317800","content":"\"I can tell you the most about Kingsbridge, it's where I've been spending most of my time.\"","created_at":"2021-07-24T00:35:15.977000Z","edited_at":null,"id":"868290201028558899","reply_to_id":null,"thread":null,"thread_id":null}
