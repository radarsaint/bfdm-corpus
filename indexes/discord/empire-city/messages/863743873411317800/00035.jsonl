{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"863743873411317800","content":"\"Also! I dunno if she just showed up this year or she's been in the city the whole time but sometimes there's a dinosaur wandering around the streets. Don't worry about her. Grimmy is nice!\"","created_at":"2021-07-24T00:36:50.846000Z","edited_at":null,"id":"868290598937972766","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"863743873411317800","content":"\"Definitely. The redcoats are laying low after their last attack and seizure of populace, but they'll be back soon enough to cause us some misery.\"","created_at":"2021-07-24T00:36:55.373000Z","edited_at":null,"id":"868290617925599242","reply_to_id":null,"thread":null,"thread_id":null}
