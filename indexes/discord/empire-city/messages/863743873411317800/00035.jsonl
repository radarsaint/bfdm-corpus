{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"863743873411317800","content":"\"Well it's been a while since I've been back in this city. I was over seas trying to get supplies and now that I'm back everything has just changed so much\" She says answering Apgan","created_at":"2021-07-24T00:32:55.822000Z","edited_at":null,"id":"868289613175873556","reply_to_id":null,"thread":null,"thread_id":null}
