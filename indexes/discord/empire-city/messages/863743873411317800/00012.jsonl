{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"863743873411317800","content":"\"Yeah, I'll have some scrambled eggs.\"","created_at":"2021-07-18T15:50:41.615000Z","edited_at":null,"id":"866346248658485268","reply_to_id":null,"thread":null,"thread_id":null}
