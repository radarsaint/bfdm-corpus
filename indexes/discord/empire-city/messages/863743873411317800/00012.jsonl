{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"863743873411317800","content":"\"I like to think she can still hear me even though I'm so far away.\"","created_at":"2021-07-18T15:52:59.284000Z","edited_at":null,"id":"866346826083991563","reply_to_id":null,"thread":null,"thread_id":null}
