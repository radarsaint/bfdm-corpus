{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"863743873411317800","content":"\"Sure thing.\"","created_at":"2021-07-18T15:51:04.280000Z","edited_at":null,"id":"866346343722647563","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"863743873411317800","content":"\"Yeah. Yesterday when we were talking.\"","created_at":"2021-07-18T15:51:38.773000Z","edited_at":null,"id":"866346488396906517","reply_to_id":null,"thread":null,"thread_id":null}
