{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"863743873411317800","content":"\"I have some too, that I haven't really been using. Between my bow, this ring, and the fancy stone, I really feel like I have all I could ask for.\"","created_at":"2021-07-27T05:31:46.090000Z","edited_at":null,"id":"869451981767475201","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"863743873411317800","content":"\"Oh, yeah. And the backpack to keep all that crud organized.\"","created_at":"2021-07-27T05:32:01.540000Z","edited_at":null,"id":"869452046569459722","reply_to_id":null,"thread":null,"thread_id":null}
