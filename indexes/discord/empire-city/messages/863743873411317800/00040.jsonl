{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"863743873411317800","content":"\"Some bread, some ham, yeah, that'll do. You know what I should see if I can make? Bugberry jam.\"","created_at":"2021-07-25T08:23:11.296000Z","edited_at":null,"id":"868770345316909096","reply_to_id":null,"thread":null,"thread_id":null}
