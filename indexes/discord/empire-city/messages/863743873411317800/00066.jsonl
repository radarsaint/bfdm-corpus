{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"863743873411317800","content":"\"Huh. The more you know.\"","created_at":"2021-07-29T15:30:56.083000Z","edited_at":null,"id":"870327542698086471","reply_to_id":null,"thread":null,"thread_id":null}
