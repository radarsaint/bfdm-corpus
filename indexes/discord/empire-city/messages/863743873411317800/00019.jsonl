{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"863743873411317800","content":"\"He already does like you, and he will continue liking you until the day he dies. He's a good man, the perfect one for you.\"","created_at":"2021-07-20T19:55:13.690000Z","edited_at":null,"id":"867132563533725696","reply_to_id":"867131859878936657","thread":null,"thread_id":null}
