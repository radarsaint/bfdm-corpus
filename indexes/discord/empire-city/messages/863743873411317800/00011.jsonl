{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"863743873411317800","content":"\"Why did the hag curse your ancestor?\"","created_at":"2021-07-17T23:52:14.911000Z","edited_at":null,"id":"866105048060526642","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"863743873411317800","content":"\"They refused to offer hospitality to her.\"","created_at":"2021-07-17T23:54:01.870000Z","edited_at":null,"id":"866105496679612426","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"863743873411317800","content":"\"Ah.\"","created_at":"2021-07-17T23:54:29.462000Z","edited_at":null,"id":"866105612407537724","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"863743873411317800","content":"\"Thats why I can never ask anyone to love me. If we were to have children they would be cursed too.\"","created_at":"2021-07-17T23:55:06.877000Z","edited_at":null,"id":"866105769338601473","reply_to_id":null,"thread":null,"thread_id":null}
