{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"863743873411317800","content":"\"Thank you. Who would ever fall in love with me?\"","created_at":"2021-07-17T23:59:43.489000Z","edited_at":"2021-07-17T23:59:52.288000Z","id":"866106929533550593","reply_to_id":null,"thread":null,"thread_id":null}
