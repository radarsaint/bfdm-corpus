{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"863743873411317800","content":"\"What did they do?\"","created_at":"2021-07-17T23:47:33.020000Z","edited_at":null,"id":"866103865723977799","reply_to_id":null,"thread":null,"thread_id":null}
