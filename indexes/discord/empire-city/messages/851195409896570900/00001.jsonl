{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851195409896570900","content":"\"I've been sent, in secret, to find more able bodies to stand with us here in Empire.\"","created_at":"2021-07-16T04:07:32.358000Z","edited_at":null,"id":"865444518357762058","reply_to_id":null,"thread":null,"thread_id":null}
