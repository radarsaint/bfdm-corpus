{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"851195409896570900","content":"\"To be ready at a minutes notice to stand against the invasion.\"","created_at":"2021-07-16T04:08:18.303000Z","edited_at":null,"id":"865444711065321472","reply_to_id":null,"thread":null,"thread_id":null}
