{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"851195363888201749","content":"\"Then those essences would be put toward the body?\"","created_at":"2021-07-30T17:32:46.440000Z","edited_at":null,"id":"870720592423321710","reply_to_id":null,"thread":null,"thread_id":null}
