{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"851195363888201749","content":"(got it)","created_at":"2021-07-30T18:15:09.905000Z","edited_at":null,"id":"870731260488720404","reply_to_id":null,"thread":null,"thread_id":null}
