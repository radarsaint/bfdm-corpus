{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"851195363888201749","content":"\"I would see both our goals furthered under your knife Miss Heore.\"","created_at":"2021-07-10T20:39:29.080000Z","edited_at":"2021-07-10T20:39:42.180000Z","id":"863519822388920340","reply_to_id":null,"thread":null,"thread_id":null}
