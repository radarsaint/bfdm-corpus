{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"851195363888201749","content":"\"We had won... But..\" He grows quieter. \"We lost Trapero... We all tried to cast spells... Trying to stop death's hold.\"","created_at":"2021-08-22T07:54:49.948000Z","edited_at":null,"id":"878910069583015967","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"851195363888201749","content":"\"When Trapero passed... I had lost it.\" He clears his throat. \"I tried to cast speak with the dead... I wanted answers...\" He looks back to Eliot. \"Prosser,... Punched me.\"","created_at":"2021-08-22T07:56:49.964000Z","edited_at":null,"id":"878910572966584320","reply_to_id":null,"thread":null,"thread_id":null}
