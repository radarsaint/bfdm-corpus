{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"851195363888201749","content":"\"Change? Aint you done that enough already?\" He chuckles sipping the glowing green drink.","created_at":"2021-08-18T04:05:15.784000Z","edited_at":null,"id":"877402745089445918","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Basil","id":"339235123759153162","is_bot":0,"username":"divinedefault"},"author_id":"339235123759153162","channel_id":"851195363888201749","content":"\"Hard to say. each day just seems to make it more and more clear I'm not the man I used to be.\"","created_at":"2021-08-18T04:06:01.635000Z","edited_at":null,"id":"877402937402458144","reply_to_id":null,"thread":null,"thread_id":null}
