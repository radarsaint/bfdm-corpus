{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"851195363888201749","content":"\"Death be onna ta strongest powers en ta vorld. I'd embrace me nature as it is ta see if me power grows vith it.\"","created_at":"2021-07-14T19:44:42.294000Z","edited_at":"2021-07-14T19:44:47.004000Z","id":"864955588072177724","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"851195363888201749","content":"she shakes her head \"What I do is give life to the dead, and alter life.  I dont reinforce death.  I could take this as payment for another alteration if youd like\"","created_at":"2021-07-14T19:46:18.609000Z","edited_at":null,"id":"864955992047484928","reply_to_id":null,"thread":null,"thread_id":null}
