{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"867300973532938280","content":"A notice is posted here: \"The redcoats are planning some sort of lockdown of Ferrytown in the evening. Do not spread word that you know this outside of here. We will have a plan by the afternoon. Prepare yourselves. We will have to bring in outside help for this, so be ready to let those not already a part of the group know when we tell you.\"","created_at":"2021-07-30T09:02:20.701000Z","edited_at":null,"id":"870592138763726858","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"867300973532938280","content":"'How would be best to get back? In theory, I could swim, but most people here aren't able to.'","created_at":"2021-07-30T09:04:41.799000Z","edited_at":null,"id":"870592730571632731","reply_to_id":null,"thread":null,"thread_id":null}
