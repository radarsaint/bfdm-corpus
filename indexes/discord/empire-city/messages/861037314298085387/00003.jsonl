{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Three question you can ask three questions we will answer. \"\n\"A miracle, a marvel, or death.\"","created_at":"2021-07-24T05:54:23.227000Z","edited_at":"2021-07-24T05:54:51.994000Z","id":"868370510415810580","reply_to_id":null,"thread":null,"thread_id":null}
