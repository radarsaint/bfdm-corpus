{"attachments":[],"author":{"display_name":"unashaminglyme","id":"340062533304057857","is_bot":0,"username":"unashaminglyme"},"author_id":"340062533304057857","channel_id":"861037314298085387","content":"'First question' the nameless thinks. \"I wish to acquire a feather with no color. I need to bring back a friend, your priestess; Irynx.\"","created_at":"2021-07-21T08:56:07.318000Z","edited_at":null,"id":"867329081892143134","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Thrice will be the asking. Thrice shall we answer. Ask a question.\"","created_at":"2021-07-21T08:56:50.202000Z","edited_at":null,"id":"867329261759889438","reply_to_id":null,"thread":null,"thread_id":null}
