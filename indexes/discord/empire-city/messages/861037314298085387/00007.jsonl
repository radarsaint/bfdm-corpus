{"attachments":[],"author":{"display_name":"Basil","id":"339235123759153162","is_bot":0,"username":"divinedefault"},"author_id":"339235123759153162","channel_id":"861037314298085387","content":"\"well, war kinda makes everyone an immediate issue or bust\"","created_at":"2021-07-26T00:21:12.956000Z","edited_at":null,"id":"869011440873394207","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"I don't know how much Willow and I can spread ourselves if we'll be the ceremonial ravens, though.\"","created_at":"2021-07-26T00:22:05.431000Z","edited_at":null,"id":"869011660969504789","reply_to_id":null,"thread":null,"thread_id":null}
