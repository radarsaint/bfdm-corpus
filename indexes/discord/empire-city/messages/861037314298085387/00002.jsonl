{"_type":"shard","campaign_names":["Empire City","Roanoke S4","Roanoke Season 4 / Empire City","Season 4, Empire City","roanoke-s4"],"channel":{"category":"Kingsbridge Noir","id":"861037314298085387","name":"grove-keeper","position":119,"server_id":"850779382791536640","topic":null,"type":"0"},"database_path":"discord/empire-city/empire-city.sqlite","database_sha256":"a0c71f99ff403e5a91d88c2dfb647326cbc332b4b943fa207cb080173a83f98e","project_ids":["roanoke-s4"],"server":{"harvested_at":"2026-10-02T13:43:57Z","id":"850779382791536640","name":"Empire City."},"server_slug":"empire-city"}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I'm... sorry...\"","created_at":"2021-07-19T01:09:14.901000Z","edited_at":null,"id":"866486813569056778","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"Seraxa tries to pull Willow into a hug.","created_at":"2021-07-19T01:09:35.537000Z","edited_at":null,"id":"866486900122058792","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"Willow accepts.","created_at":"2021-07-19T01:09:46.273000Z","edited_at":null,"id":"866486945151713290","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Please don't tell Finn... I don't want him to hate me, too...\"","created_at":"2021-07-19T01:10:28.466000Z","edited_at":null,"id":"866487122121850937","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"My village kicked me out... I told him I ran... he can't know...\"","created_at":"2021-07-19T01:12:11.512000Z","edited_at":null,"id":"866487554328363029","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"You don't need to be sorry, and I won't tell.\" She presses her finger to her lips. \"It's your secret to share.\"","created_at":"2021-07-19T01:14:07.505000Z","edited_at":null,"id":"866488040838660097","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Thank you...\"","created_at":"2021-07-19T01:14:19.772000Z","edited_at":null,"id":"866488092290711562","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"What did you give to the ravens?\"","created_at":"2021-07-19T01:14:30.926000Z","edited_at":null,"id":"866488139074109480","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"I'll be honest, I don't entirely know,\" she jokes. \"All I really gave was answer. They traded one thing for another. I promised I would be a refuge for people who needed it, and in return they gave Irinx her spirit back.\"","created_at":"2021-07-19T01:20:34.155000Z","edited_at":null,"id":"866489662566563901","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"Serax purses her lips. \"I came here to help you, but you've also given me some....\" she squints, \"hope? Clarity?\"","created_at":"2021-07-19T01:22:19.622000Z","edited_at":null,"id":"866490104926699521","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"Willow smiles","created_at":"2021-07-19T01:23:25.217000Z","edited_at":null,"id":"866490380052594739","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"I'm still walking in the body that the hags made for me. Irinx should have hers back.\" Seraxa nods, mostly to herself. \"If there's a price you have to pay, then I'll pay it with you.\"","created_at":"2021-07-19T01:24:06.089000Z","edited_at":"2021-07-19T01:24:12.176000Z","id":"866490551481794571","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I can't ask you to do that, Seraxa.\"","created_at":"2021-07-19T01:24:28.198000Z","edited_at":null,"id":"866490644214186034","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"It's as much for me as it is for you.\"","created_at":"2021-07-19T01:24:42.810000Z","edited_at":null,"id":"866490705500045332","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"The thing is... I don't just want my soul back... I want... my body... if thats a thing they can do...\"","created_at":"2021-07-19T01:26:11.881000Z","edited_at":null,"id":"866491079091683328","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"She deserves that, at least.\"","created_at":"2021-07-19T01:27:01.954000Z","edited_at":null,"id":"866491289113329664","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I'll let her take over once she's free... I'll be the one to hide...\"","created_at":"2021-07-19T01:27:42.611000Z","edited_at":null,"id":"866491459641278484","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"Both of us, Irinx and Willow.\"","created_at":"2021-07-19T01:28:00.694000Z","edited_at":null,"id":"866491535487139880","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"Maybe the price will be steeper for two hexbloods but, we'll pay it together.\"","created_at":"2021-07-19T01:28:12.263000Z","edited_at":null,"id":"866491584010911794","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Thank you, Seraxa...\"","created_at":"2021-07-19T01:28:37.743000Z","edited_at":null,"id":"866491690881384448","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"Like I said, it's actually a little selfish. You don't need to thank me for wanting to do something for myself.\"","created_at":"2021-07-19T01:30:44.402000Z","edited_at":null,"id":"866492222126948352","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"You're being selfish for a selfless reason, and thats enough for me.\"","created_at":"2021-07-19T01:31:41.041000Z","edited_at":null,"id":"866492459688263700","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"So how does the process work?\"","created_at":"2021-07-19T01:32:41.852000Z","edited_at":null,"id":"866492714748739604","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Making a trade with the ravens, I mean.\"","created_at":"2021-07-19T01:32:56.055000Z","edited_at":null,"id":"866492774319783936","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"I've only been there once so that's my only frame of reference but...\" Seraxa tries to recall. \"You get three questions to ask, so make them count. And then they ask you questions, and you get three chances to answer.\"","created_at":"2021-07-19T01:35:27.156000Z","edited_at":null,"id":"866493408084623370","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Do I have to ask three questions?\"","created_at":"2021-07-19T01:36:22.030000Z","edited_at":null,"id":"866493638242074624","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"You probably don't need to if you know the question you want to ask. I know I did. I was just scared of the change, so I asked too many.\"","created_at":"2021-07-19T01:37:37.445000Z","edited_at":null,"id":"866493954556297246","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I'm scared too... what if I have to give up...\"","created_at":"2021-07-19T01:39:02.075000Z","edited_at":null,"id":"866494309519065109","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"My love...\"","created_at":"2021-07-19T01:39:09.084000Z","edited_at":null,"id":"866494338916679701","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"I don't think the ravens would be so cruel.\"","created_at":"2021-07-19T01:39:42.342000Z","edited_at":null,"id":"866494478412021810","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"Willow is now nervously sweating and pacing.","created_at":"2021-07-19T01:40:38.586000Z","edited_at":null,"id":"866494714316193802","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I should just find another option... I can't risk him...\"","created_at":"2021-07-19T01:41:11.239000Z","edited_at":null,"id":"866494851272409149","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"But.. this seems like the only way...\"","created_at":"2021-07-19T01:41:22.812000Z","edited_at":null,"id":"866494899813875753","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"There's always the fey, if you have any interest in dealing with them again.\"","created_at":"2021-07-19T01:42:29.262000Z","edited_at":null,"id":"866495178525507634","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"Two of my friends died last week, and I brought them to this dryad in Ferrytown. She's nice, for the most part. But the price my friends had to pay was steep. One even lost his name!\"","created_at":"2021-07-19T01:43:09.396000Z","edited_at":null,"id":"866495346859573248","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Oh no... now I fear the price I'll have to pay may be just as steep...\"","created_at":"2021-07-19T01:44:01.153000Z","edited_at":null,"id":"866495563942592552","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I should just give up... I'll never be free...\"","created_at":"2021-07-19T01:45:29.459000Z","edited_at":null,"id":"866495934324932628","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"One of the ravens pecks your ear.\n\n\"Hey! No thinking like that.\"","created_at":"2021-07-19T01:47:38.635000Z","edited_at":null,"id":"866496476129919026","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"Willow just sits on the ground.","created_at":"2021-07-19T01:48:30.043000Z","edited_at":null,"id":"866496691749650452","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I don't even have anything to give them that would have worth...\"","created_at":"2021-07-19T01:48:59.671000Z","edited_at":null,"id":"866496816019406848","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"The ravens won't take your happiness, or anything you don't want to let go, if that's a concern.\"","created_at":"2021-07-19T01:51:18.135000Z","edited_at":null,"id":"866497396779384894","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"There is so much I don't want to give up though...\"","created_at":"2021-07-19T02:04:53.161000Z","edited_at":null,"id":"866500815246196736","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"But what do you have to gain?\"","created_at":"2021-07-19T02:05:23.304000Z","edited_at":null,"id":"866500941674315786","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"What do you mean?\"","created_at":"2021-07-19T02:06:06.017000Z","edited_at":null,"id":"866501120825884692","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"If we get Willow back, what does she have waiting for her? Will it be worth whatever you have to give up?\"","created_at":"2021-07-19T02:11:17.507000Z","edited_at":null,"id":"866502427310030919","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"She has Finn waiting for her... and friends...\"","created_at":"2021-07-19T02:12:41.784000Z","edited_at":null,"id":"866502780793126942","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"But I don't want to give up something that should be hers.\"","created_at":"2021-07-19T02:12:58.341000Z","edited_at":null,"id":"866502850237169714","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"(brb)","created_at":"2021-07-19T02:15:32.752000Z","edited_at":null,"id":"866503497884106762","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"(back)","created_at":"2021-07-19T02:17:32.251000Z","edited_at":null,"id":"866503999100682250","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"I can't give you the best advice for this,\" Seraxa says. \"But I sincerely believe it will be worth it for the both of us.\"","created_at":"2021-07-19T02:18:56.463000Z","edited_at":null,"id":"866504352310099970","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I think... I know...\"","created_at":"2021-07-19T02:23:04.386000Z","edited_at":null,"id":"866505392175317012","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"If I must give up myself so that she may be happy...\"","created_at":"2021-07-19T02:23:18.793000Z","edited_at":null,"id":"866505452602392616","reply_to_id":null,"thread":null,"thread_id":null}
