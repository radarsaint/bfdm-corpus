{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"Seraxa takes Willow's hand. \"You got this.\"","created_at":"2021-07-19T03:20:34.770000Z","edited_at":null,"id":"866519864133550080","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Thank you.\"","created_at":"2021-07-19T03:20:58.368000Z","edited_at":null,"id":"866519963111784468","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I come to ask for something.\"","created_at":"2021-07-19T03:21:10.485000Z","edited_at":null,"id":"866520013933772820","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Thrice you will ask. Thrice we will answer.\"","created_at":"2021-07-19T03:21:29.276000Z","edited_at":null,"id":"866520092749332530","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Will you help me sever my deal with the hag that made me?\"","created_at":"2021-07-19T03:22:21.015000Z","edited_at":null,"id":"866520309758689281","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"If a price is paid.\"","created_at":"2021-07-19T03:22:36.419000Z","edited_at":null,"id":"866520374366699521","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Once asked, Once ansered.\"","created_at":"2021-07-19T03:22:49.693000Z","edited_at":null,"id":"866520430042284082","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Will you return me to my original body?\"","created_at":"2021-07-19T03:22:57.812000Z","edited_at":null,"id":"866520464095445002","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"To sever is one price. To restore what was lost is another.\"","created_at":"2021-07-19T03:23:28.914000Z","edited_at":null,"id":"866520594546819122","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Twice asked. Twice answered.\"","created_at":"2021-07-19T03:23:58.187000Z","edited_at":null,"id":"866520717327335444","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"What price must I pay?\"","created_at":"2021-07-19T03:24:08.943000Z","edited_at":null,"id":"866520762440220732","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Shallow for one. Deeper for the other.\"\n\n\"Thrice we have been asked. Thrice we have answered.\"\n\n\"What payment do you offer? A thought, a memory, or a life?\"","created_at":"2021-07-19T03:25:14.182000Z","edited_at":"2021-07-19T03:25:27.509000Z","id":"866521036073074710","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"Seraxa's hand tightens on Willow's.","created_at":"2021-07-19T03:25:35.738000Z","edited_at":null,"id":"866521126486540319","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I offer the memory of my father's death, for the first.\"","created_at":"2021-07-19T03:25:59.370000Z","edited_at":null,"id":"866521225606201364","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"Huginn alights on your shoulder.","created_at":"2021-07-19T03:26:24.783000Z","edited_at":null,"id":"866521332195000351","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"And for the second, I offer this body for my old one.\"","created_at":"2021-07-19T03:26:58.822000Z","edited_at":null,"id":"866521474966093854","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"Muninn does not join Huginn.","created_at":"2021-07-19T03:27:31.813000Z","edited_at":null,"id":"866521613338673163","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"Your father's passing is no more. The threads of life from your heart to the heart of the hag Pasiphae is cut.","created_at":"2021-07-19T03:28:33.534000Z","edited_at":null,"id":"866521872215310367","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"Forgive me, but I don't have a question. A request, if I may.\"","created_at":"2021-07-19T03:29:07.931000Z","edited_at":null,"id":"866522016487178250","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"I want to follow her.\" She turns to Willow. \"There is a body and a life I have left behind, like she did. For the second, I want to follow.\"","created_at":"2021-07-19T03:30:36.703000Z","edited_at":null,"id":"866522388823539732","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"The body wracked by hex is not a loss to you. It does not pay a debt. Being rid of a hated form and gaining a new form are two boons. Offer us more.\"","created_at":"2021-07-19T03:32:44.287000Z","edited_at":"2021-07-19T03:33:41.234000Z","id":"866522923951063040","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"What is a life of centuries worth?\"","created_at":"2021-07-19T03:34:28.467000Z","edited_at":null,"id":"866523360912211998","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Thrice shall we be asked. Thrice we shall answer.\"\n\"A clean slate of thousands of years would pay for Evelyns body.\"\n\"Once answered.\"","created_at":"2021-07-19T03:35:38.620000Z","edited_at":"2021-07-19T03:35:46.147000Z","id":"866523655155482634","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"What would pay for mine?\"","created_at":"2021-07-19T03:36:22.244000Z","edited_at":null,"id":"866523838128455710","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Pact keeper. You shall seek to convert another to be our disciple, we wish to have a hand in what is to come. As a pact holder, your word is bond. Your powers will be forfeit if you stop trying.\"\n\"Twice have you asked. Twice have we answered.\"","created_at":"2021-07-19T03:38:34.093000Z","edited_at":"2021-07-19T03:38:55.181000Z","id":"866524391143637022","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"Seraxa looks at Willow. \"I know it's not what we discussed but... this will do it.\"","created_at":"2021-07-19T03:45:04.018000Z","edited_at":null,"id":"866526026606837770","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I can't ask you to do this, I'm all out of questions. But you still have once more to ask.\"","created_at":"2021-07-19T03:46:17.139000Z","edited_at":null,"id":"866526333298147329","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"Still holding Willow's hand, she looks back at the ravens. \"Is there a price we both can share?\"","created_at":"2021-07-19T03:47:51.432000Z","edited_at":null,"id":"866526728793096232","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Thrice you have asked. Thrice you shall be answered.\"\n\"Lives dedicated to our service. Should either of you ever bare life, raise them under the tenants of the Raven.\"","created_at":"2021-07-19T03:51:41.318000Z","edited_at":"2021-07-19T03:51:58.802000Z","id":"866527693004734484","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Watch over the thoughts of your people\nHeal your people of the trauma of memory\nBe willing to give life that others may live.\"","created_at":"2021-07-19T03:54:36.341000Z","edited_at":null,"id":"866528427103485993","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"Willow glances at Seraxa.","created_at":"2021-07-19T03:56:59.916000Z","edited_at":null,"id":"866529029301207050","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"Those are things I would believe in.\" Her voice is weirdly raspy. \"If you agree to the price, then I will too.\"","created_at":"2021-07-19T03:57:30.285000Z","edited_at":null,"id":"866529156678680576","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"I agree.\"","created_at":"2021-07-19T03:57:45.695000Z","edited_at":null,"id":"866529221312643112","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"A flock of ravens descends upon you until all is black.","created_at":"2021-07-19T03:58:58.183000Z","edited_at":null,"id":"866529525349613579","reply_to_id":null,"thread":null,"thread_id":null}
