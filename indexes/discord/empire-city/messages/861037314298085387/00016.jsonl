{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"He spoke of Nidhogg to you.\"","created_at":"2021-07-30T07:54:04.473000Z","edited_at":null,"id":"870574957938245642","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Nidhogg promised that none who knew your name would ever bother you with anything about Nidhogg again.\"","created_at":"2021-07-30T07:54:46.770000Z","edited_at":null,"id":"870575135344693259","reply_to_id":null,"thread":null,"thread_id":null}
