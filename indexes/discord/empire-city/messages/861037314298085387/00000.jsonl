{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Thrice was the asking. Thrice was the answering. A debt is owed. A memory, a thought or a life. What shall you pay?\"","created_at":"2021-07-13T02:31:23.366000Z","edited_at":"2021-07-13T02:31:35.526000Z","id":"864333157855002667","reply_to_id":null,"thread":null,"thread_id":null}
