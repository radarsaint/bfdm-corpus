{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"It says \"speak.\"","created_at":"2021-07-13T02:21:58.979000Z","edited_at":null,"id":"864330790643826698","reply_to_id":null,"thread":null,"thread_id":null}
