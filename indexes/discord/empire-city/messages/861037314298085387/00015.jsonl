{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Angry? What a plucky owl like you got to be angry about? You've got two arms, two legs and a torso. I'm not ahead of anyone, but you don't see me blowing my top.\"","created_at":"2021-07-30T07:25:25.329000Z","edited_at":null,"id":"870567747325673474","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"Maybe anger isn't the right word. It's many things, all at once. Anger and frustration and disgust and betrayal. It's like this cocktail my brain is forcing me to feel and it kinda tastes like... I dunno, pee probably.\"","created_at":"2021-07-30T07:28:38.905000Z","edited_at":null,"id":"870568559242280980","reply_to_id":null,"thread":null,"thread_id":null}
