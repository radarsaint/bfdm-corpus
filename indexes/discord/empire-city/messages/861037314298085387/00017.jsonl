{"attachments":[],"author":{"display_name":"Basil","id":"339235123759153162","is_bot":0,"username":"divinedefault"},"author_id":"339235123759153162","channel_id":"861037314298085387","content":"\"from what I can tell, one person gives up their life to be reborn with the dead one. can one life resurrect two others?\"","created_at":"2021-08-15T04:09:35.908000Z","edited_at":null,"id":"876316672531767317","reply_to_id":null,"thread":null,"thread_id":null}
