{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Your body will be interred at a place of your choosing, but you shall bury something of your precious in the grave that shall open in the grove. As a thanks to the Ravens for facilitating this.\"","created_at":"2021-08-22T01:46:01.617000Z","edited_at":"2021-08-22T01:46:22.280000Z","id":"878817256635764737","reply_to_id":null,"thread":null,"thread_id":null}
