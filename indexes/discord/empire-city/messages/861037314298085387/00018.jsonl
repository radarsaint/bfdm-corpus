{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"We shall remain within this grove until you return as and Exarch. A Warden of Arcania.\"","created_at":"2021-08-22T01:44:56.183000Z","edited_at":null,"id":"878816982185685053","reply_to_id":null,"thread":null,"thread_id":null}
