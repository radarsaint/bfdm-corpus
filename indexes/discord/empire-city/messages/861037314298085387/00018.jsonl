{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Your time does draw near. As is the way of the Soldier.\" Says Huginn.\n\"Your time does not draw near as the voice of the downtrodden.\" Says Muninn.","created_at":"2021-08-22T01:00:30.791000Z","edited_at":"2021-08-22T01:00:42.421000Z","id":"878805802721370162","reply_to_id":null,"thread":null,"thread_id":null}
