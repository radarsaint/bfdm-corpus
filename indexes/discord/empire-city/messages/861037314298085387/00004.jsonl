{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"861037314298085387","content":"\"Yes. Gone. To Nifhel, the underworld of their kind.\"","created_at":"2021-07-24T06:31:05.667000Z","edited_at":null,"id":"868379748118695936","reply_to_id":null,"thread":null,"thread_id":null}
