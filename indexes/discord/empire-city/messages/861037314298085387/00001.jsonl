{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861037314298085387","content":"\"That life belonged to someone else. And when I changed, I tucked her away, so she'd be safe.\"","created_at":"2021-07-19T00:52:58.595000Z","edited_at":null,"id":"866482718643453983","reply_to_id":null,"thread":null,"thread_id":null}
