{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"861037314298085387","content":"\"Yeah, I don't want her to be hidden anymore. She definitely deserves the happiness more than I...\"","created_at":"2021-07-19T00:58:35.500000Z","edited_at":null,"id":"866484131725705216","reply_to_id":null,"thread":null,"thread_id":null}
