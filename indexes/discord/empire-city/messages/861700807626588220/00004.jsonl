{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"861700807626588220","content":"\"does that align with your beliefs?\"","created_at":"2021-07-14T13:11:35.165000Z","edited_at":null,"id":"864856656482664479","reply_to_id":null,"thread":null,"thread_id":null}
