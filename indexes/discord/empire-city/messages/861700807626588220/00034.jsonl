{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861700807626588220","content":"\"Memory is different. I have a thousand years of that. My recall isn't perfect but sometimes I get attacked by the old times,\" she laughs. \"I'm not the Priestess of Memory. I'm the Priestess of Thought! Those I have way more often.\"","created_at":"2021-07-26T13:12:10.673000Z","edited_at":null,"id":"869205459800842260","reply_to_id":null,"thread":null,"thread_id":null}
