{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861700807626588220","content":"\"It was once the rotting heart of Hampstead, with all the horrible experiences to go with it, but it won't be anymore.\"","created_at":"2021-08-27T06:48:12.609000Z","edited_at":"2021-08-27T06:48:20.616000Z","id":"880705242856034334","reply_to_id":null,"thread":null,"thread_id":null}
