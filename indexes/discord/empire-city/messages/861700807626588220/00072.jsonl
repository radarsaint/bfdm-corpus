{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"Yeah it's just a different state of mind. Just like Kukudh is their own state of mind.\"","created_at":"2021-08-24T06:48:23.498000Z","edited_at":null,"id":"879618124931027006","reply_to_id":null,"thread":null,"thread_id":null}
