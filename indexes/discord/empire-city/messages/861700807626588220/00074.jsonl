{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"It was a beast that attacked us once before, that they tried to spare and reason with. It came back for them.\"","created_at":"2021-08-24T20:44:31.081000Z","edited_at":null,"id":"879828543025074186","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"MinaPoe","id":"443806147649208341","is_bot":0,"username":"minapoe"},"author_id":"443806147649208341","channel_id":"861700807626588220","content":"\"W-was it a wolf?\"","created_at":"2021-08-24T20:45:06.483000Z","edited_at":null,"id":"879828691511820298","reply_to_id":null,"thread":null,"thread_id":null}
