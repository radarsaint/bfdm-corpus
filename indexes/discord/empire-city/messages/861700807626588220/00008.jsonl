{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"Oh, nice. I haven't even checked how Ferrytown's been since that attack. Good to see someone is doing the work there too.\"","created_at":"2021-07-17T09:27:07.149000Z","edited_at":null,"id":"865887331126476810","reply_to_id":null,"thread":null,"thread_id":null}
