{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"Looks kinda past midnight. Bugger, I lost track of time. I planned to start my night shift today much earlier. Is something wrong?\"","created_at":"2021-07-17T09:15:14.233000Z","edited_at":null,"id":"865884340940439552","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"861700807626588220","content":"'N-no, I---I'm just... a bit dizzy.'","created_at":"2021-07-17T09:16:02.060000Z","edited_at":null,"id":"865884541540499497","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"Seasick?\"","created_at":"2021-07-17T09:18:30.688000Z","edited_at":null,"id":"865885164931514378","reply_to_id":null,"thread":null,"thread_id":null}
