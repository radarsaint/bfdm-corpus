{"attachments":[],"author":{"display_name":"MinaPoe","id":"443806147649208341","is_bot":0,"username":"minapoe"},"author_id":"443806147649208341","channel_id":"861700807626588220","content":"\"All I've got to worry about are hungry weerewolves\" there is a pause \"and a very determined T-rex\"","created_at":"2021-07-21T22:36:13.566000Z","edited_at":null,"id":"867535467855347722","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"StarPilot94","id":"468162764586876949","is_bot":0,"username":"starpilot94"},"author_id":"468162764586876949","channel_id":"861700807626588220","content":"“T-rex? You mean the big sweet one?” She quirks a smile. “She want to use you as a chew toy?” She teased, with a giggle coming not long after.","created_at":"2021-07-21T22:37:58.049000Z","edited_at":null,"id":"867535906087632906","reply_to_id":null,"thread":null,"thread_id":null}
