{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"Yeah, we heard about it from them at the campfire. They had marshmallows.\"","created_at":"2021-08-22T10:24:57.033000Z","edited_at":null,"id":"878947848035663913","reply_to_id":null,"thread":null,"thread_id":null}
