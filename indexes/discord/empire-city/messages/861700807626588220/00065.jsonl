{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"I don't know what's with the name either, but it was like white and sweet, and even better when roasted over fire.\"","created_at":"2021-08-22T10:26:22.856000Z","edited_at":null,"id":"878948208003416074","reply_to_id":null,"thread":null,"thread_id":null}
