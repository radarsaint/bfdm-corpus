{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"861700807626588220","content":"\"Think of it... Like I'm paying all of you back... For all the kindness you'e all shown me... Even when I didn't deserve it... You've all treated me rather well.\" He chuckles","created_at":"2021-08-25T05:47:32.444000Z","edited_at":null,"id":"879965199166234655","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861700807626588220","content":"\"What you deserve is never going to dictate what you get.\"","created_at":"2021-08-25T05:47:51.508000Z","edited_at":null,"id":"879965279126437913","reply_to_id":null,"thread":null,"thread_id":null}
