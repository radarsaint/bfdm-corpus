{"attachments":[],"author":{"display_name":"TAO","id":"267178019196633099","is_bot":0,"username":"dm_tao"},"author_id":"267178019196633099","channel_id":"861700807626588220","content":"\"But no one faults you for trying.\" he pats Franklin on the back.","created_at":"2021-07-27T02:00:13.376000Z","edited_at":"2021-07-27T02:00:19.762000Z","id":"869398744666345472","reply_to_id":null,"thread":null,"thread_id":null}
