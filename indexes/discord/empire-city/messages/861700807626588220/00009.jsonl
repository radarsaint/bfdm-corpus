{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861700807626588220","content":"||\"SERAXA'S VOICE IN YOUR HEAD! WHAT WHAT!!!\"||","created_at":"2021-07-17T11:45:14.849000Z","edited_at":null,"id":"865922092260392981","reply_to_id":null,"thread":null,"thread_id":null}
