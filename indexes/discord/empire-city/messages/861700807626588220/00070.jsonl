{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"I'd consider taking them apart and putting them together into a bigger ship, but I think where we'll be going eventually it'll be better to travel by land.\"","created_at":"2021-08-22T18:31:02.262000Z","edited_at":null,"id":"879070175872307203","reply_to_id":null,"thread":null,"thread_id":null}
