{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"861700807626588220","content":"'You have my permission, but... you shouldn't need it. What sort of a priestess would I be if I turned you out?'","created_at":"2021-08-20T19:05:56.584000Z","edited_at":null,"id":"878354184364253234","reply_to_id":null,"thread":null,"thread_id":null}
