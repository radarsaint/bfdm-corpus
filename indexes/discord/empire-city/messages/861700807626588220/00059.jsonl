{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"861700807626588220","content":"\"sounds like a life partner to me.... put it off too long... and you may lose each other before you see that life grow... Dont let teh sun set before you even see the sun rise\" he says still laying back","created_at":"2021-08-20T19:20:19.263000Z","edited_at":null,"id":"878357802702233661","reply_to_id":null,"thread":null,"thread_id":null}
