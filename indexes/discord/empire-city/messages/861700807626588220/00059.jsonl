{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"861700807626588220","content":"'So I'm wondering... do you know how I can not get stuck in flashbacks like that...?'","created_at":"2021-08-20T18:44:40.883000Z","edited_at":null,"id":"878348833686450217","reply_to_id":null,"thread":null,"thread_id":null}
