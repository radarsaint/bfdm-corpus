{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"861700807626588220","content":"\"Fine, I suppose. I just had to calm down. Which I suppose I didn't really get to do before. So that's one positive, maybe?\"","created_at":"2021-07-14T06:32:46.608000Z","edited_at":null,"id":"864756292840849428","reply_to_id":null,"thread":null,"thread_id":null}
