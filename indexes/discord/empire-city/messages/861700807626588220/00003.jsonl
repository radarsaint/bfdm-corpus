{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"861700807626588220","content":"'I don't... know what potential... a mangled corpse has. But I try... and find mine.'","created_at":"2021-07-13T16:18:15.117000Z","edited_at":null,"id":"864541244621586463","reply_to_id":null,"thread":null,"thread_id":null}
