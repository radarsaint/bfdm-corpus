{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"861700807626588220","content":"'I believe... curfew started. No... Hampstead. What... a shame.'","created_at":"2021-07-14T06:37:15.959000Z","edited_at":null,"id":"864757422581481532","reply_to_id":null,"thread":null,"thread_id":null}
