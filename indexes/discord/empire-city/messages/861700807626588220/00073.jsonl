{"attachments":[],"author":{"display_name":"Mistah Noodles","id":"363458590461132800","is_bot":0,"username":"mistahnoodles"},"author_id":"363458590461132800","channel_id":"861700807626588220","content":"\"I don't really have a preference. I'm sorry Sabrine, that was rude of me. I don't know either of you that great, but whichever one of you stays I'd certainly appreciate the company\"","created_at":"2021-08-24T11:47:22.602000Z","edited_at":null,"id":"879693366986670120","reply_to_id":null,"thread":null,"thread_id":null}
