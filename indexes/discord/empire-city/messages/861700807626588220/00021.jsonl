{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"861700807626588220","content":"\"We're all prestidigititators,\" she mistakenly adds the extra syllable, as she interchanges between cleaning around and then throwing pies.","created_at":"2021-07-22T07:26:39.606000Z","edited_at":null,"id":"867668955942617129","reply_to_id":null,"thread":null,"thread_id":null}
