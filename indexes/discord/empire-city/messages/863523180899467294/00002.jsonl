{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"863523180899467294","content":"'How will I be able to have a normal life? Who would want to live with a corpse?'","created_at":"2021-07-15T18:08:51.828000Z","edited_at":null,"id":"865293856736018464","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"863523180899467294","content":"\"Not who you were, i said who you are.  Who you were is dead.  Hell tomorrow the me of today is dead, and tomorrow it'll be a new me that is me\"","created_at":"2021-07-15T18:09:27.058000Z","edited_at":null,"id":"865294004500561930","reply_to_id":null,"thread":null,"thread_id":null}
