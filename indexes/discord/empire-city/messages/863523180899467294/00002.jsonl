{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"863523180899467294","content":"'Can I enjoy who I am... with the knowledge that I am not truly a person?'","created_at":"2021-07-15T18:07:59.827000Z","edited_at":null,"id":"865293638627229736","reply_to_id":null,"thread":null,"thread_id":null}
