{"attachments":[],"author":{"display_name":"BenevolentDM","id":"470420431841656833","is_bot":0,"username":"benevolentdm"},"author_id":"470420431841656833","channel_id":"863686287244656660","content":"\"Excellent... Kneel Jigsaw, I shall bestow upon you a *new* title, and welcome you into my sanctum.\" Malathor says as he stands from his seat.","created_at":"2021-07-25T23:05:10.781000Z","edited_at":"2021-07-25T23:05:21.737000Z","id":"868992305724530758","reply_to_id":null,"thread":null,"thread_id":null}
