{"attachments":[],"author":{"display_name":"Mistah Noodles","id":"363458590461132800","is_bot":0,"username":"mistahnoodles"},"author_id":"363458590461132800","channel_id":"852742259073744937","content":"\"Tonight? If you're not busy...\" Eloise asks, (and Noodles tampers with the forth wall).","created_at":"2021-08-26T00:59:14.972000Z","edited_at":null,"id":"880255036175814656","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"852742259073744937","content":"\"That works for me.\" He nods, before looking off to the east. \"I... I think I may be needed.\" He sighs. \"I had hoped one evil to fight was enough. I'll likely be supporting those who are fighting soon. Despite what you saw yesterday, my talents are actually best used keeping other in the fight. Would you care to accompany me?\"","created_at":"2021-08-26T01:02:53.735000Z","edited_at":null,"id":"880255953734369361","reply_to_id":null,"thread":null,"thread_id":null}
