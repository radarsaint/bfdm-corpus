{"_type":"shard","campaign_names":["Empire City","Roanoke S4","Roanoke Season 4 / Empire City","Season 4, Empire City","roanoke-s4"],"channel":{"category":"Ferrytown","id":"852742259073744937","name":"jameco🍄🌳","position":80,"server_id":"850779382791536640","topic":"Named for the original human residents, Jameco is a community built primarily of these native peoples and fey bleed over. It is home to the Ferrytown court and resides between The Mounds and Grassy Bay. The sacred tree, Cael'fii, grows here.","type":"0"},"database_path":"discord/empire-city/empire-city.sqlite","database_sha256":"a0c71f99ff403e5a91d88c2dfb647326cbc332b4b943fa207cb080173a83f98e","project_ids":["roanoke-s4"],"server":{"harvested_at":"2026-10-02T13:43:57Z","id":"850779382791536640","name":"Empire City."},"server_slug":"empire-city"}
