{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"852742259073744937","content":"He shakes his head. \"Nonsense. I've seen the food you can make and the assistance you can provide, even if you only feel up for non-magical assistance. I promise, you would be of great help.\"","created_at":"2021-08-26T01:05:44.130000Z","edited_at":null,"id":"880256668422766663","reply_to_id":null,"thread":null,"thread_id":null}
