{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"852742259073744937","content":"\"So that's what this does...\"","created_at":"2021-08-05T06:45:41.411000Z","edited_at":null,"id":"872732075642458152","reply_to_id":null,"thread":null,"thread_id":null}
