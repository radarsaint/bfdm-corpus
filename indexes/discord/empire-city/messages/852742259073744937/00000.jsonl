{"attachments":[],"author":{"display_name":"unashaminglyme","id":"340062533304057857","is_bot":0,"username":"unashaminglyme"},"author_id":"340062533304057857","channel_id":"852742259073744937","content":"\"It would be rude to not accept hospitality as a guest.\" Luard replies in a polite tone. \"I would love some.\"","created_at":"2021-07-13T16:00:25.743000Z","edited_at":null,"id":"864536759340367942","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Boggman","id":"860303482065256448","is_bot":0,"username":"boggman1"},"author_id":"860303482065256448","channel_id":"852742259073744937","content":"\"Hello a pleasure to meet you the names Thomas and I would gladly have some after all of this walking.\"","created_at":"2021-07-13T16:01:00.697000Z","edited_at":null,"id":"864536905948725258","reply_to_id":null,"thread":null,"thread_id":null}
