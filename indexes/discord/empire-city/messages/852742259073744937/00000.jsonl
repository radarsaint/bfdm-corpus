{"attachments":[],"author":{"display_name":"D (they/them)","id":"692746345387130900","is_bot":0,"username":"nonbianarydarry"},"author_id":"692746345387130900","channel_id":"852742259073744937","content":"\"Pleasure to meet both of you, I'm Ferrah and this is Vlinder. This is our home.\"","created_at":"2021-07-13T16:04:49.232000Z","edited_at":null,"id":"864537864493596693","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Boggman","id":"860303482065256448","is_bot":0,"username":"boggman1"},"author_id":"860303482065256448","channel_id":"852742259073744937","content":"\"It very lovely.\"","created_at":"2021-07-13T16:06:38.991000Z","edited_at":null,"id":"864538324857651226","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"unashaminglyme","id":"340062533304057857","is_bot":0,"username":"unashaminglyme"},"author_id":"340062533304057857","channel_id":"852742259073744937","content":"\"It sure is lovely in here. I'm glad to be free of the bustle of the cities for even just a bit.\"","created_at":"2021-07-13T16:06:39.052000Z","edited_at":null,"id":"864538325112193034","reply_to_id":null,"thread":null,"thread_id":null}
