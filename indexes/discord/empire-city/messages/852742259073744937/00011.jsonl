{"attachments":[],"author":{"display_name":"Pandamaster_0","id":"292531828592738304","is_bot":0,"username":"pandamaster_1"},"author_id":"292531828592738304","channel_id":"852742259073744937","content":"Rax replies aloud \"i seem to have foud myself in quite an unfortunate situation, and was hoping to try and find someone who might know what has happened\"","created_at":"2021-07-30T21:50:00.692000Z","edited_at":null,"id":"870785328368189452","reply_to_id":null,"thread":null,"thread_id":null}
