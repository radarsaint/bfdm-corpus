{"attachments":[],"author":{"display_name":"unashaminglyme","id":"340062533304057857","is_bot":0,"username":"unashaminglyme"},"author_id":"340062533304057857","channel_id":"851195531837308928","content":"This piques Luard's interest. \"Find what out?\"","created_at":"2021-07-14T11:44:10.526000Z","edited_at":null,"id":"864834658873245706","reply_to_id":null,"thread":null,"thread_id":null}
