{"attachments":[],"author":{"display_name":"unashaminglyme","id":"340062533304057857","is_bot":0,"username":"unashaminglyme"},"author_id":"340062533304057857","channel_id":"851195531837308928","content":"\"Fine, keep your secrets.\"","created_at":"2021-07-14T11:44:32.415000Z","edited_at":null,"id":"864834750682365962","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"851195531837308928","content":"\"She's like a cat. Escaping near-death experiences.\"","created_at":"2021-07-14T11:44:44.501000Z","edited_at":null,"id":"864834801373675540","reply_to_id":null,"thread":null,"thread_id":null}
