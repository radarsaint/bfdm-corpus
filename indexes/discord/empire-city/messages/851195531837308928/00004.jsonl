{"attachments":[],"author":{"display_name":"chinea","id":"740639937677754539","is_bot":0,"username":"franczine"},"author_id":"740639937677754539","channel_id":"851195531837308928","content":"Meorys makes the motion to drink from the water, then stops at Seraxa's words.","created_at":"2021-07-14T11:52:30.903000Z","edited_at":null,"id":"864836757605449729","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"chinea","id":"740639937677754539","is_bot":0,"username":"franczine"},"author_id":"740639937677754539","channel_id":"851195531837308928","content":"\"Do you both plan on staying here till curfew ends?\"","created_at":"2021-07-14T11:53:01.470000Z","edited_at":null,"id":"864836885813657610","reply_to_id":null,"thread":null,"thread_id":null}
