{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"862869435940339732","content":"Prosser nods and smiles. \"First off, do you have any aliases, secret identities, or other disguises under which we might know of you?\"","created_at":"2021-07-23T19:19:15.255000Z","edited_at":"2021-07-23T19:23:35.561000Z","id":"868210673996423210","reply_to_id":null,"thread":null,"thread_id":null}
