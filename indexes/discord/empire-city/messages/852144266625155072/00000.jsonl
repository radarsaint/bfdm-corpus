{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"852144266625155072","content":"\"I don't know what marks you offer, but if there is a way that I don't have to worry about myself, then I can worry over this city.\"\n\n\"I am willing to give my life so that others can live, but I can't fulfill our pact if this continues.\"","created_at":"2021-07-21T06:24:28.299000Z","edited_at":null,"id":"867290917840093184","reply_to_id":null,"thread":null,"thread_id":null}
