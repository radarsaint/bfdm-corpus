{"attachments":[],"author":{"display_name":"Siren","id":"809288447151439872","is_bot":0,"username":"sirenssong17"},"author_id":"809288447151439872","channel_id":"860204853145501776","content":"\"I could offer you control over the color of my irises from day to day...\"","created_at":"2021-07-15T03:55:14.104000Z","edited_at":null,"id":"865079034031636490","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"D (they/them)","id":"692746345387130900","is_bot":0,"username":"nonbianarydarry"},"author_id":"692746345387130900","channel_id":"860204853145501776","content":"She nods. \"Oh really it's more abstract then future favors. I like to deal in the now. For instance I could take some of your life (age 3d6 years) AND your ability to speak Common. Or I could take some of your Charisma (-2). Or I could take all of your memories of you and who you are and maybe a few (4d6) years off your life.\"","created_at":"2021-07-15T03:57:34.781000Z","edited_at":null,"id":"865079624072429608","reply_to_id":null,"thread":null,"thread_id":null}
