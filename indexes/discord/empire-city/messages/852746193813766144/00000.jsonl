{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"852746193813766144","content":"\"You didn't strike me as rabbitfolk. More jackalope, and jackalopes have antlers! Also because *I see all*!!!\" She jokes.","created_at":"2021-07-12T05:06:39.402000Z","edited_at":null,"id":"864009844276461578","reply_to_id":null,"thread":null,"thread_id":null}
