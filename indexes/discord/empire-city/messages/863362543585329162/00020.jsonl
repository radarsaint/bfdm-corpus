{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"863362543585329162","content":"\"Yes! Because you broke up with her. Why? He was head over heels for you.  How could you hurt her like that?\"","created_at":"2021-07-26T15:58:26.639000Z","edited_at":null,"id":"869247302034939985","reply_to_id":null,"thread":null,"thread_id":null}
