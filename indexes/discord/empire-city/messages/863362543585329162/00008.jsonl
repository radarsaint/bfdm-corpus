{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"863362543585329162","content":"'But I mean,' Sabrine speaks through them, revealing their location anyway, 'no birds strictly to watch out for. For us, anyway.'","created_at":"2021-07-15T19:27:48.523000Z","edited_at":null,"id":"865313723873886229","reply_to_id":null,"thread":null,"thread_id":null}
