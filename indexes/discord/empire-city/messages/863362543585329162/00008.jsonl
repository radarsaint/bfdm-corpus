{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"863362543585329162","content":"'...oh, that's where I was. We took Tort to this lady in Hampstead, who had apparently, ah... worked on him before.'","created_at":"2021-07-15T19:56:23.449000Z","edited_at":null,"id":"865320916794998804","reply_to_id":null,"thread":null,"thread_id":null}
