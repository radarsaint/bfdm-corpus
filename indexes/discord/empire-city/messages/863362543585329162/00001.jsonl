{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"863362543585329162","content":"\"Maybe even more beastly, if they willingly stay in the fog down below.\"","created_at":"2021-07-11T08:07:21.948000Z","edited_at":null,"id":"863692933345181696","reply_to_id":null,"thread":null,"thread_id":null}
