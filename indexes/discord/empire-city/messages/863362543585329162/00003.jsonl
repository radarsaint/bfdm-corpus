{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"863362543585329162","content":"\"Roy Gat, jobless night-shifter. And I suppose Sabrine already did her telepathic thing.\"","created_at":"2021-07-13T08:05:36.844000Z","edited_at":null,"id":"864417268238909450","reply_to_id":null,"thread":null,"thread_id":null}
