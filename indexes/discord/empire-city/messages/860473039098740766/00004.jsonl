{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860473039098740766","content":"\"All at once, last friday. I think that is where they have pulled back to. At the factory, if anywhere.\"","created_at":"2021-07-22T03:30:19.174000Z","edited_at":null,"id":"867609478899826729","reply_to_id":null,"thread":null,"thread_id":null}
