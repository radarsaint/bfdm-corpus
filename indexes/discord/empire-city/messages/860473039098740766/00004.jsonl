{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"860473039098740766","content":"\"Yes my friend? What is your name and how can we be of service?\"","created_at":"2021-07-22T03:26:21.507000Z","edited_at":null,"id":"867608482052309024","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860473039098740766","content":"\"Oh, me? I'm Private First Class mounted division. Or I was until Basalt Base Fell in the Waste.\"","created_at":"2021-07-22T03:27:33.276000Z","edited_at":null,"id":"867608783071871017","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860473039098740766","content":"\"Has word gotten out? Did anyone else make it off the island?\"","created_at":"2021-07-22T03:28:00.472000Z","edited_at":null,"id":"867608897141604363","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"860473039098740766","content":"\"An attack or natural causes? I'm afraid this is the first I've heard\"","created_at":"2021-07-22T03:28:15.551000Z","edited_at":null,"id":"867608960387252246","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860473039098740766","content":"\"It was a disaster. The entire island has fallen to the Red Coats, sir.\"","created_at":"2021-07-22T03:29:07.377000Z","edited_at":null,"id":"867609177760071711","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860473039098740766","content":"\"We were overrun. Not a single town yet stands.\"","created_at":"2021-07-22T03:29:24.873000Z","edited_at":null,"id":"867609251144138772","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"860473039098740766","content":"\"How long ago was this? Before or after their attack on this city last Thursday\"","created_at":"2021-07-22T03:29:35.702000Z","edited_at":null,"id":"867609296564781097","reply_to_id":null,"thread":null,"thread_id":null}
