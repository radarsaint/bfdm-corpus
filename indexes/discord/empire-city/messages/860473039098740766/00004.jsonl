{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"860473039098740766","content":"\"They descended upon us with a sand storm. They have laid all vegetation to waste.\"","created_at":"2021-07-22T03:31:03.834000Z","edited_at":"2021-07-22T03:31:15.491000Z","id":"867609666217443358","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"860473039098740766","content":"\"Did they bring their provisions with them? Or did they leave the base to strike somewhere else next\"","created_at":"2021-07-22T03:31:40.073000Z","edited_at":null,"id":"867609818213777470","reply_to_id":null,"thread":null,"thread_id":null}
