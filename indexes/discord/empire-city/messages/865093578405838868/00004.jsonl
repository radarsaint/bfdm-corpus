{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"865093578405838868","content":"\"But he didn't get the chance. So us children took I upon ourselves to prove everything.\"","created_at":"2021-07-23T23:50:08.880000Z","edited_at":null,"id":"868278846640775168","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"865093578405838868","content":"\"That night the men group of men caught us. There was a fight. They we were trying to get away. They were take trying to deal with us too. I kicked one and he fell far.\" She stops and grabs her arms and shivers \"Then all of the sudden everything went black for me.\"","created_at":"2021-07-23T23:53:50.804000Z","edited_at":null,"id":"868279777457492059","reply_to_id":null,"thread":null,"thread_id":null}
