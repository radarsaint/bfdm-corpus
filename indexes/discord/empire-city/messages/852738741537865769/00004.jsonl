{"attachments":[],"author":{"display_name":"TAO","id":"267178019196633099","is_bot":0,"username":"dm_tao"},"author_id":"267178019196633099","channel_id":"852738741537865769","content":"\"Panache? Not familiar with him, no. But I have been here only 3 days. I am quite adept at finding information if you need me to locate him.\"","created_at":"2021-07-13T00:13:54.570000Z","edited_at":"2021-07-13T00:14:17.750000Z","id":"864298559897075773","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"TAO","id":"267178019196633099","is_bot":0,"username":"dm_tao"},"author_id":"267178019196633099","channel_id":"852738741537865769","content":"\"Is he a friend of yours?\"","created_at":"2021-07-13T00:14:41.945000Z","edited_at":null,"id":"864298758603014144","reply_to_id":null,"thread":null,"thread_id":null}
