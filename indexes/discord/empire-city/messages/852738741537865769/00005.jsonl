{"attachments":[],"author":{"display_name":"TAO","id":"267178019196633099","is_bot":0,"username":"dm_tao"},"author_id":"267178019196633099","channel_id":"852738741537865769","content":"Tears well up in his eyes.","created_at":"2021-07-14T01:22:29.639000Z","edited_at":null,"id":"864678207613042689","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"TAO","id":"267178019196633099","is_bot":0,"username":"dm_tao"},"author_id":"267178019196633099","channel_id":"852738741537865769","content":"\"It was... my sister's\"","created_at":"2021-07-14T01:22:39.900000Z","edited_at":null,"id":"864678250651582466","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"TAO","id":"267178019196633099","is_bot":0,"username":"dm_tao"},"author_id":"267178019196633099","channel_id":"852738741537865769","content":"\"She...\"","created_at":"2021-07-14T01:22:55.120000Z","edited_at":null,"id":"864678314488496128","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"TAO","id":"267178019196633099","is_bot":0,"username":"dm_tao"},"author_id":"267178019196633099","channel_id":"852738741537865769","content":"\"She died many years ago, this was hers. She was a cartographer.\"","created_at":"2021-07-14T01:23:56.691000Z","edited_at":null,"id":"864678572734939177","reply_to_id":null,"thread":null,"thread_id":null}
