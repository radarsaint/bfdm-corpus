{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"851227479112548382","content":"\"I am *disgusted* by the respect you give me as your captain. I don't want it.\"","created_at":"2021-07-30T06:55:59.661000Z","edited_at":null,"id":"870560341577302037","reply_to_id":null,"thread":null,"thread_id":null}
