{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"879698332434460672","content":"The tea is *excellent*, though it is much more earthy than the kinds Demetrius prefers, as his are often airy and full of herbs.","created_at":"2021-08-25T03:21:55.345000Z","edited_at":null,"id":"879928553116930098","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"879698332434460672","content":"\"Is that an agreeable proposition?\" Gaillardia asks. \"Because of the deal Demetrius and I made, you won't even need a list others have to collect. He provided a few things.\"","created_at":"2021-08-25T03:22:51.930000Z","edited_at":null,"id":"879928790451638282","reply_to_id":null,"thread":null,"thread_id":null}
