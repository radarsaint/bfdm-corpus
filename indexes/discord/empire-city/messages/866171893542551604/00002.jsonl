{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"866171893542551604","content":"\"No. My name is Edward Wong Hau Pepelu Tivrusky IV. I am hope.\"","created_at":"2021-07-27T04:35:08.134000Z","edited_at":null,"id":"869437729707016243","reply_to_id":null,"thread":null,"thread_id":null}
