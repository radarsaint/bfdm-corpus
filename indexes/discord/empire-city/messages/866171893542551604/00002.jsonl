{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"866171893542551604","content":"\"We already know an Ed.\"","created_at":"2021-07-27T04:36:25.802000Z","edited_at":null,"id":"869438055470202890","reply_to_id":null,"thread":null,"thread_id":null}
