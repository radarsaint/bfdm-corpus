{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"855583918468235264","content":"\"No, it was when I was living alone. It was a while ago.\"","created_at":"2021-07-15T18:47:49.623000Z","edited_at":null,"id":"865303662158282772","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"855583918468235264","content":"\"If you don't mind me asking, where did you come from before this?\"","created_at":"2021-07-15T18:48:14.453000Z","edited_at":null,"id":"865303766303899738","reply_to_id":null,"thread":null,"thread_id":null}
