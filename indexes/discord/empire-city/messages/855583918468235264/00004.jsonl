{"attachments":[],"author":{"display_name":"MinaPoe","id":"443806147649208341","is_bot":0,"username":"minapoe"},"author_id":"443806147649208341","channel_id":"855583918468235264","content":"(can or cant, Fuddles?)","created_at":"2021-07-19T17:37:07.158000Z","edited_at":null,"id":"866735419432370186","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"855583918468235264","content":"\"Then I imagine it will hurt, like love tends to do. Is that so terrible, pain?\"","created_at":"2021-07-19T17:38:15.408000Z","edited_at":null,"id":"866735705694666792","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"MinaPoe","id":"443806147649208341","is_bot":0,"username":"minapoe"},"author_id":"443806147649208341","channel_id":"855583918468235264","content":"\"Love is capable of so much, even if it hurts. It can elevate us\"","created_at":"2021-07-19T17:39:46.464000Z","edited_at":"2021-07-19T17:39:51.764000Z","id":"866736087610818622","reply_to_id":null,"thread":null,"thread_id":null}
