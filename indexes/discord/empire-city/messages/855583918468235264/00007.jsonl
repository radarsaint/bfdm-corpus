{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"855583918468235264","content":"\"There is forces in this world, that are older than magic. Older than gods and monsters. Entropy, Chaos, Time. The old powers. The things we forget have lives of their own. Thoughts of their own. Wants and needs.\"","created_at":"2021-08-18T07:24:55.062000Z","edited_at":null,"id":"877452989823066132","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"855583918468235264","content":"\"A child of Chaos was born, it was called Aberration\"","created_at":"2021-08-18T07:25:24.879000Z","edited_at":null,"id":"877453114884644884","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"855583918468235264","content":"\"It is chaos in generational change.\"","created_at":"2021-08-18T07:25:44.374000Z","edited_at":"2021-08-18T07:25:53.080000Z","id":"877453196652609536","reply_to_id":null,"thread":null,"thread_id":null}
