{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"855583918468235264","content":"\"And there was once a mind in the deep place in the world with whom abberation resonated more than any other.\"","created_at":"2021-08-18T07:26:53.898000Z","edited_at":null,"id":"877453488257380362","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"855583918468235264","content":"\"Croatoan, was a being that hated order. That hated life that continued in an orderly way.\"","created_at":"2021-08-18T07:27:36.153000Z","edited_at":null,"id":"877453665487708190","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"855583918468235264","content":"\"He left Mantopolis and sunk down to the darkest part of the ocean, where he called upon the abberation to change his own body.\"","created_at":"2021-08-18T07:28:30.011000Z","edited_at":null,"id":"877453891384516678","reply_to_id":null,"thread":null,"thread_id":null}
