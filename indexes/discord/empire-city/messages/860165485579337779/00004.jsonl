{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"860165485579337779","content":"\"What would hold that idea? Would it be a stone as well?\"","created_at":"2021-08-17T15:11:36.346000Z","edited_at":null,"id":"877208047854964756","reply_to_id":null,"thread":null,"thread_id":null}
