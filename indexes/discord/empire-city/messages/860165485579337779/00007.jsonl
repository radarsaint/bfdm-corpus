{"attachments":[],"author":{"display_name":"MinaPoe","id":"443806147649208341","is_bot":0,"username":"minapoe"},"author_id":"443806147649208341","channel_id":"860165485579337779","content":"\"So we can all agree that we need to seize the day then? There is no need to dwell in what's been done, but instead look into what we can do today and how we will continue from now\"","created_at":"2021-08-23T19:14:36.254000Z","edited_at":null,"id":"879443527615000686","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"860165485579337779","content":"'...yes. I'm sorry. I just... wish I could have helped...'","created_at":"2021-08-23T19:16:43.968000Z","edited_at":null,"id":"879444063286345749","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"860165485579337779","content":"\"We helped by not making him worry in an important moment.\"","created_at":"2021-08-23T19:17:08.960000Z","edited_at":null,"id":"879444168110383174","reply_to_id":null,"thread":null,"thread_id":null}
