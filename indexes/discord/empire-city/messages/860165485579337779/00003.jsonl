{"attachments":[],"author":{"display_name":"Cruithne","id":"150319814836092928","is_bot":0,"username":"cruithne"},"author_id":"150319814836092928","channel_id":"860165485579337779","content":"'Things change, and we need to accept the change and change with them, or we'll be left behind.'","created_at":"2021-08-16T17:57:24.996000Z","edited_at":null,"id":"876887387651854386","reply_to_id":null,"thread":null,"thread_id":null}
