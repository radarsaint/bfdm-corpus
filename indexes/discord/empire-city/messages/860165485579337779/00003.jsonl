{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"860165485579337779","content":"\"Is it cornerstone-worth level of important, though, is what I'm thinking.\"","created_at":"2021-08-16T17:58:31.018000Z","edited_at":null,"id":"876887664568184842","reply_to_id":null,"thread":null,"thread_id":null}
