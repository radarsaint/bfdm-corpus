{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"860165485579337779","content":"\"I believe there might be something about the hotel in Feytown? Vivica went there, but apparently can't say anything about the investigation from there due to a deal with the fey.\"","created_at":"2021-07-30T17:44:28.941000Z","edited_at":null,"id":"870723538926055465","reply_to_id":null,"thread":null,"thread_id":null}
