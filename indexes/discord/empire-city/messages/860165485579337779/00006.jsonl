{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"860165485579337779","content":"\"Oh, I was just curious if the invitation thing and the protection magic on it still works with Gil getting a promotion.\"","created_at":"2021-08-23T17:54:28.703000Z","edited_at":null,"id":"879423363284623383","reply_to_id":null,"thread":null,"thread_id":null}
