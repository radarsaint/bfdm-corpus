{"attachments":[],"author":{"display_name":"Versil","id":"148682928434577408","is_bot":0,"username":"versil"},"author_id":"148682928434577408","channel_id":"850783473010475008","content":"oh yeah I forgot to mention you can add `adv` or `dis` to the skill check. I couldn't get it into the untrained int check because all the code for that had to fid in a discord message","created_at":"2021-07-21T13:15:14.860000Z","edited_at":null,"id":"867394293009219596","reply_to_id":null,"thread":null,"thread_id":null}
