{"attachments":[],"author":{"display_name":"D (they/them)","id":"692746345387130900","is_bot":0,"username":"nonbianarydarry"},"author_id":"692746345387130900","channel_id":"860204961300217856","content":"\"Ferrytown is in need of those like you.\"","created_at":"2021-08-12T18:47:38.112000Z","edited_at":null,"id":"875450474113941534","reply_to_id":null,"thread":null,"thread_id":null}
