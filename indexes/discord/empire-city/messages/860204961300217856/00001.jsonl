{"attachments":[],"author":{"display_name":"D (they/them)","id":"692746345387130900","is_bot":0,"username":"nonbianarydarry"},"author_id":"692746345387130900","channel_id":"860204961300217856","content":"\"Some of their strength or wisdom, years off their life, things that matter more than material things. Tell me dear, what do you fight for, I sense you are a brutal Warrior and yet also a nurturing healer.\"","created_at":"2021-08-12T18:43:36.349000Z","edited_at":null,"id":"875449460086423632","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Srg. Waffles","id":"430898830498725888","is_bot":0,"username":"srg.waffles"},"author_id":"430898830498725888","channel_id":"860204961300217856","content":"\"Well to put it plainly, I fight wars to end wars. While it feels that war will never end, I want to make it where we can get closer to stopping wars.\"","created_at":"2021-08-12T18:45:15.518000Z","edited_at":null,"id":"875449876031356979","reply_to_id":null,"thread":null,"thread_id":null}
