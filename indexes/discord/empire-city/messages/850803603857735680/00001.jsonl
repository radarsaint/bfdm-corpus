{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"850803603857735680","content":"\"I myself am curious about the case of the Clutters--whatever damage their killers were going to do to the noir has been averted, but I don't believe we have found their killers. I understand with both the lamplighters and the umbral cup out of commission, there may not be any reward available, but...\"","created_at":"2021-07-21T06:59:01.414000Z","edited_at":null,"id":"867299613115809802","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"850803603857735680","content":"\"The case remains of interest to me. I'm looking for a woman named Opal, if she's still in town.\"","created_at":"2021-07-21T06:59:26.341000Z","edited_at":null,"id":"867299717666308116","reply_to_id":null,"thread":null,"thread_id":null}
