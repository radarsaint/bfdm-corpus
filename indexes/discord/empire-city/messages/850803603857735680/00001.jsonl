{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"850803603857735680","content":"\"This is Seargeant Nolan Reeve, I am Apgan, and that is Eliza. We are seeking to take on the charitable work that the lamplighter's undertook, and are looking for some assistance on some of their mysteries.\"","created_at":"2021-07-21T06:56:34.533000Z","edited_at":"2021-07-21T06:56:40.322000Z","id":"867298997050933278","reply_to_id":null,"thread":null,"thread_id":null}
