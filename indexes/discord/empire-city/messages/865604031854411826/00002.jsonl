{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"865604031854411826","content":"\"I will. Thank you so much Finn. You've been so nice to me, ever since I got here.\"","created_at":"2021-07-27T19:49:00.230000Z","edited_at":null,"id":"869667712186609734","reply_to_id":null,"thread":null,"thread_id":null}
