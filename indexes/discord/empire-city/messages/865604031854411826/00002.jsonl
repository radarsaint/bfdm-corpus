{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"865604031854411826","content":"\"I don't know... I'm not as good with words as you...\"","created_at":"2021-07-27T19:46:27.218000Z","edited_at":null,"id":"869667070407741450","reply_to_id":null,"thread":null,"thread_id":null}
