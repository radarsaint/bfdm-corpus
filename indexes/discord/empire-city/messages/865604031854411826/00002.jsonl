{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"865604031854411826","content":"\"Don't you forget that. Stay near Nolan when you can\"","created_at":"2021-07-27T19:45:28.965000Z","edited_at":null,"id":"869666826076946432","reply_to_id":null,"thread":null,"thread_id":null}
