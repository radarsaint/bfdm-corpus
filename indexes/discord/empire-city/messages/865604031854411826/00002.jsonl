{"attachments":[],"author":{"display_name":"harpy","id":"651981368175230976","is_bot":0,"username":"harpsy_cored"},"author_id":"651981368175230976","channel_id":"865604031854411826","content":"\"And its not like I can play an instrument or anything.\" Willow hold up her shaky hands.","created_at":"2021-07-27T19:47:03.972000Z","edited_at":null,"id":"869667224565202945","reply_to_id":null,"thread":null,"thread_id":null}
