{"category":"Ferrytown","id":"852746408783904798","index_path":"messages/852746408783904798/index.json","message_count":1105,"name":"crepes-and-crits-cafe☕🐈","position":77,"server_id":"850779382791536640","topic":"Run by Eliot, an immigrant human, and staffed with animals, the crepes and crits cafe is a popular hangout spot for the young children with animal features who sleep in the parks of ferrytown.","type":"0"}
