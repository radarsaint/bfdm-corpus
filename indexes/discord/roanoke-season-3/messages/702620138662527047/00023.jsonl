{"attachments":[],"author":{"display_name":"Ozen","id":"321508500138360843","is_bot":0,"username":"ozenannwn"},"author_id":"321508500138360843","channel_id":"702620138662527047","content":"\"I am sure there will be new opportunity. I wonder if zombees make honey?\"","created_at":"2020-07-24T01:01:50.088000Z","edited_at":null,"id":"736025316270669844","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"702620138662527047","content":"\"I do not know, truthfully. If it requires more than mechanical movements than likely not, but I am unsure.\"","created_at":"2020-07-24T01:02:36.010000Z","edited_at":null,"id":"736025508881629195","reply_to_id":null,"thread":null,"thread_id":null}
