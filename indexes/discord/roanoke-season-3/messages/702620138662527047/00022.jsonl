{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"702620138662527047","content":"Web leads Leaf and Fabertell into the dark and wet below. \"You're going to want a light if you can't see through the dark.\"","created_at":"2020-07-23T23:55:02.572000Z","edited_at":null,"id":"736008507530412053","reply_to_id":null,"thread":null,"thread_id":null}
