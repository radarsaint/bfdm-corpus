{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"733827592045461538","content":"\"The town as it is feels homey enough. Castle walls do help ease the mind\"","created_at":"2020-08-03T06:04:03.629000Z","edited_at":null,"id":"739725252510220331","reply_to_id":null,"thread":null,"thread_id":null}
