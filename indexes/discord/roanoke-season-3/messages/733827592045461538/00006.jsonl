{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"733827592045461538","content":"She nods \"I didn't see a ship when you all arrived. How did you get here?\"","created_at":"2020-08-03T05:57:29.241000Z","edited_at":null,"id":"739723598326923366","reply_to_id":null,"thread":null,"thread_id":null}
