{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"733827592045461538","content":"\"A kraken attacked your ship? How unfortunate, thank the Gods you all survived.\"","created_at":"2020-08-03T05:59:38.160000Z","edited_at":null,"id":"739724139052400680","reply_to_id":null,"thread":null,"thread_id":null}
