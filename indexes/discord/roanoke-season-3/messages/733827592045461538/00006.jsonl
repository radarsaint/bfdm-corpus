{"attachments":[],"author":{"display_name":"justjack420","id":"592252026226999306","is_bot":0,"username":"justjack420"},"author_id":"592252026226999306","channel_id":"733827592045461538","content":"\"Oh an uh O wills it an such.\" She adds sheepishly.","created_at":"2020-08-03T05:55:07.301000Z","edited_at":null,"id":"739723002987675779","reply_to_id":null,"thread":null,"thread_id":null}
