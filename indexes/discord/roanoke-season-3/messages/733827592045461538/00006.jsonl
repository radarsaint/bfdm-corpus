{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"733827592045461538","content":"Rigatony glances over his shoulder, \"No, later\" he whispers","created_at":"2020-08-03T05:52:50.438000Z","edited_at":null,"id":"739722428942516264","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"733827592045461538","content":"\"So tell me, why come here?\"","created_at":"2020-08-03T05:53:05.883000Z","edited_at":null,"id":"739722493723541536","reply_to_id":null,"thread":null,"thread_id":null}
