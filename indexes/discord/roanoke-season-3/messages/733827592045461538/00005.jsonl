{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"733827592045461538","content":"\"Oh, no I'm originally from Scotland.\"","created_at":"2020-08-03T05:20:43.513000Z","edited_at":null,"id":"739714346833281054","reply_to_id":null,"thread":null,"thread_id":null}
