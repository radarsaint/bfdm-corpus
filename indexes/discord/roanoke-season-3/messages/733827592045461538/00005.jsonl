{"attachments":[],"author":{"display_name":"justjack420","id":"592252026226999306","is_bot":0,"username":"justjack420"},"author_id":"592252026226999306","channel_id":"733827592045461538","content":"\"We need somethin ta roast o'er this fire.\" Kiln sits up quickly. \"Like some yams an browned sugar.\"","created_at":"2020-08-03T05:11:58.621000Z","edited_at":null,"id":"739712145276665936","reply_to_id":null,"thread":null,"thread_id":null}
