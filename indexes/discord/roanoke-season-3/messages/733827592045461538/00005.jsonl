{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"733827592045461538","content":"\"Pleased to meet you.\" She gives a soft smile","created_at":"2020-08-03T05:21:25.910000Z","edited_at":null,"id":"739714524659056720","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"justjack420","id":"592252026226999306","is_bot":0,"username":"justjack420"},"author_id":"592252026226999306","channel_id":"733827592045461538","content":"\"Also from tha highlands meself.\"","created_at":"2020-08-03T05:21:27.396000Z","edited_at":null,"id":"739714530892054652","reply_to_id":null,"thread":null,"thread_id":null}
