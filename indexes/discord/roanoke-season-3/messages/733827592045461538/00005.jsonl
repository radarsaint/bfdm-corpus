{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"733827592045461538","content":"\"I never thought I'd meet others from Europe again.\"","created_at":"2020-08-03T05:22:52.023000Z","edited_at":null,"id":"739714885843156994","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"733827592045461538","content":"\"How did you find yourself in the New World Miss Baker?\"","created_at":"2020-08-03T05:23:36.620000Z","edited_at":null,"id":"739715072896663642","reply_to_id":null,"thread":null,"thread_id":null}
