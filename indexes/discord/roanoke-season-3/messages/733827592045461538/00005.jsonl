{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"733827592045461538","content":"The cogs are already turning in Riga's head. \"Diplomacy you say...\"","created_at":"2020-08-03T05:25:31.346000Z","edited_at":null,"id":"739715554092515379","reply_to_id":null,"thread":null,"thread_id":null}
