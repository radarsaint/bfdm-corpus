{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"733827592045461538","content":"\"I was shown another...\"","created_at":"2020-08-06T01:28:34.357000Z","edited_at":null,"id":"740743087315484695","reply_to_id":null,"thread":null,"thread_id":null}
