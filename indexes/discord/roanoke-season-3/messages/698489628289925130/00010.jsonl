{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"698489628289925130","content":"\"Then should we really start a war now?... To let all those souls free in death?... Or should we preserve them as long as they can for the hunger to have a more fitting meal?\"","created_at":"2020-08-12T20:12:01.538000Z","edited_at":null,"id":"743200140717981696","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"698489628289925130","content":"\"It is trivial. The war had already begun. We will use it for our own devices. You have done well. The chaos of the colony and beautiful information from your Knight order has helped Parchtongue escape. Your next task will come soon enough\"","created_at":"2020-08-12T20:14:26.285000Z","edited_at":null,"id":"743200747830640690","reply_to_id":null,"thread":null,"thread_id":null}
