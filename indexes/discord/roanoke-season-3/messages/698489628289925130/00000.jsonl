{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"698489628289925130","content":"(Im asumimg this key is what allows me to come here yes?)","created_at":"2020-07-24T04:38:32.686000Z","edited_at":null,"id":"736079853119602699","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"698489628289925130","content":"\"To facilitate trust, you should understand where my loyalties lie. I have spent my whole life in service to the Urukocra, and that is what motivates me. It is not for power's sake that I pursued your offer, not personal power anyway, but to enhance the Urokocran nation. I believe that the Urukocra must ally with powerful forces if they wish to continue to dominate Arcadia--and the Golden Dawn seem like just the sort of people who can help. As long as the Golden Dawn are a friend to the Urukocra, my loyalty to the Golden Dawn is absolute.\"","created_at":"2020-07-24T04:39:27.225000Z","edited_at":"2020-07-24T04:39:37.484000Z","id":"736080081872617544","reply_to_id":null,"thread":null,"thread_id":null}
