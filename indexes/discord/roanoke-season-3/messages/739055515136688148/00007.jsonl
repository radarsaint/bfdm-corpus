{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"739055515136688148","content":"\"The problem is... If we let Web go... then Web is free to cause more blight on us.....  Web has made intent of breaking the laws clear.... and Web has made it obvious Web has no regard for our safety.... \" pauses long, to let Cato think about what is being said","created_at":"2020-08-11T16:48:15.933000Z","edited_at":"2020-08-11T16:48:35.392000Z","id":"742786474948165762","reply_to_id":null,"thread":null,"thread_id":null}
