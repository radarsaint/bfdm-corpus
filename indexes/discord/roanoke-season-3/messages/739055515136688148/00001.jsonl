{"attachments":[],"author":{"display_name":"DCJJ","id":"629235245291667476","is_bot":0,"username":"dcjj"},"author_id":"629235245291667476","channel_id":"739055515136688148","content":"“I think that would be very smart.”","created_at":"2020-08-02T20:07:09.890000Z","edited_at":null,"id":"739575038801477725","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739055515136688148","content":"\"Stay true friend.\" Cato gives Copper a strong hug. \"And um sorry about the scarring.\"","created_at":"2020-08-02T20:07:43.893000Z","edited_at":null,"id":"739575181420265634","reply_to_id":null,"thread":null,"thread_id":null}
