{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739055515136688148","content":"\"Yes a double date.\"","created_at":"2020-08-03T01:12:18.445000Z","edited_at":null,"id":"739651830446948382","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"739055515136688148","content":"“Of course!”","created_at":"2020-08-03T01:12:25.756000Z","edited_at":null,"id":"739651861111636049","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739055515136688148","content":"\"Do you know what happened with Wynne?\"","created_at":"2020-08-03T01:13:05.669000Z","edited_at":null,"id":"739652028518629427","reply_to_id":null,"thread":null,"thread_id":null}
