{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739055515136688148","content":"\"I want to bring Wren. I worry if we don't let her explore at all she will try without us.\"","created_at":"2020-08-03T01:10:59.042000Z","edited_at":null,"id":"739651497406496819","reply_to_id":null,"thread":null,"thread_id":null}
