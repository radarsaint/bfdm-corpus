{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739055515136688148","content":"\"They asked to be alone, but I think they need community and care. I don't think their own thoughts are good for them.\"","created_at":"2020-08-03T01:20:36.612000Z","edited_at":null,"id":"739653919910920294","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"739055515136688148","content":"“It’s hard. They’ve been through a lot. You don’t walk away from demons and devils without scars, whether they’re on the inside or the outside.”","created_at":"2020-08-03T01:21:55.787000Z","edited_at":null,"id":"739654251994939403","reply_to_id":null,"thread":null,"thread_id":null}
