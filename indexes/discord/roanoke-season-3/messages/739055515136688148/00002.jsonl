{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739055515136688148","content":"Lilia waves at Wren as she leaves","created_at":"2020-08-04T18:07:50.830000Z","edited_at":null,"id":"740269787258814598","reply_to_id":null,"thread":null,"thread_id":null}
