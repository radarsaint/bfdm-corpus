{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"739055141759615027","content":"\"Its not so much that I had to to stand in her shadow. Its that I chose to. Amara was the musical talent and I was emptying the pockets talent. I chose to be that so Amara wouldn't have to.\"","created_at":"2020-08-04T01:49:07.988000Z","edited_at":null,"id":"740023485807722618","reply_to_id":null,"thread":null,"thread_id":null}
