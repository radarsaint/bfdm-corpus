{"attachments":[],"author":{"display_name":"that person logan","id":"519566652824616973","is_bot":0,"username":"thatpersonlogan"},"author_id":"519566652824616973","channel_id":"739055141759615027","content":"She stops crying and wipes her eyes","created_at":"2020-08-13T04:32:53.442000Z","edited_at":null,"id":"743326187538874418","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739055141759615027","content":"|| \"I pray to thee Raven Queen, watch over Sandigills soul. Lead him to you. He was brave and kind and wanted nothing more the to help perserve life. He was of two worlds as he said, just like I am. He was my friend and I cared for him. Please take care of him as we put him to rest, watch over his soul. Goddess of Death take care of him now as he has taken care of so many others.\"||","created_at":"2020-08-13T04:33:00.373000Z","edited_at":null,"id":"743326216609595403","reply_to_id":null,"thread":null,"thread_id":null}
