{"attachments":[],"author":{"display_name":"✨Fuddles✨","id":"403783497564684291","is_bot":0,"username":"fuddlescottage"},"author_id":"403783497564684291","channel_id":"739055141759615027","content":"\"You ment no disrespect but yet you still created them. The first thing his was tasked to stop you do after he dies. How is there no disrespect?\"","created_at":"2020-08-13T20:43:41.346000Z","edited_at":null,"id":"743570496955875398","reply_to_id":null,"thread":null,"thread_id":null}
