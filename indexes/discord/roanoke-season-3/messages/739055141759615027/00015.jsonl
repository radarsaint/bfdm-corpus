{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739055141759615027","content":"\"Ophelia.. Web wants to protect us. To help, this is how they know how to do it..\" she is trying to help but doesn't know the right words.","created_at":"2020-08-13T20:47:55.890000Z","edited_at":null,"id":"743571564590661682","reply_to_id":null,"thread":null,"thread_id":null}
