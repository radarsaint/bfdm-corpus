{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736448287510495254","content":"\"Navar, Eubuc, Amara, Calmation. I did not try to stop Navar from going. I had faith. I was a fool. Web was right they never had a chance. A fools errand, and I sat by and allowed it to happen.\"","created_at":"2020-07-31T13:20:54.019000Z","edited_at":null,"id":"738748023256907816","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736448287510495254","content":"\"Four more to add to my record. 6 in total, but one of those I cannot bear to see everyday.\"","created_at":"2020-07-31T13:22:03.081000Z","edited_at":null,"id":"738748312923930685","reply_to_id":null,"thread":null,"thread_id":null}
