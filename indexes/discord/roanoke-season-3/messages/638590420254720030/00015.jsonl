{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"638590420254720030","content":"\"How do you feel about keeping your memories after death?\"","created_at":"2020-08-11T01:34:30.986000Z","edited_at":null,"id":"742556522453794836","reply_to_id":null,"thread":null,"thread_id":null}
