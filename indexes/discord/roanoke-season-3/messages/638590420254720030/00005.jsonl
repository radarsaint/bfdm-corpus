{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"638590420254720030","content":"\"So I returned. They had something a bit different than Excalibur. Le Sepulchre de Sainte-Chapelle\"","created_at":"2020-07-30T01:10:55.116000Z","edited_at":null,"id":"738201929477259317","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"638590420254720030","content":"\"They had me place my hand on it\"","created_at":"2020-07-30T01:11:08.031000Z","edited_at":null,"id":"738201983646957639","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"638590420254720030","content":"\"And I felt the presence of God's long lost. It restored my faith for the gods\"","created_at":"2020-07-30T01:11:30.914000Z","edited_at":null,"id":"738202079625216052","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"638590420254720030","content":"\"From there I did all in my power to help others and even took it as my name\"","created_at":"2020-07-30T01:12:02.065000Z","edited_at":null,"id":"738202210281980024","reply_to_id":null,"thread":null,"thread_id":null}
