{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"636019335231569940","content":"\"Shes helping me...\" pausing and looks back \"everyone needs help.... what would you do for you if you could?\"","created_at":"2020-07-29T21:16:17.015000Z","edited_at":null,"id":"738142881642184744","reply_to_id":null,"thread":null,"thread_id":null}
