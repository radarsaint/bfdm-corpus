{"attachments":[],"author":{"display_name":"Mistah Noodles","id":"363458590461132800","is_bot":0,"username":"mistahnoodles"},"author_id":"363458590461132800","channel_id":"733827435103125594","content":"Baeshra joins them in consuming the bear. Being through to eat anything that is not bone or claw.","created_at":"2020-08-16T08:58:45.683000Z","edited_at":null,"id":"744480259684171896","reply_to_id":null,"thread":null,"thread_id":null}
