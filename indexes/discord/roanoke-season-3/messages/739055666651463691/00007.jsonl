{"attachments":[],"author":{"display_name":"schrödingers dumbass","id":"264570136025890816","is_bot":0,"username":"greylikessharks"},"author_id":"264570136025890816","channel_id":"739055666651463691","content":"“It’s not Golden Dawn or any other organization. I promise.”","created_at":"2020-08-06T22:01:29.112000Z","edited_at":null,"id":"741053359926149212","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739055666651463691","content":"\"Then why won't you tell me?\"","created_at":"2020-08-06T22:02:07.717000Z","edited_at":null,"id":"741053521847124048","reply_to_id":null,"thread":null,"thread_id":null}
