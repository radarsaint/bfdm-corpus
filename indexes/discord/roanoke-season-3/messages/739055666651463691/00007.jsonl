{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739055666651463691","content":"\"What is happening.\"","created_at":"2020-08-06T21:52:30.561000Z","edited_at":null,"id":"741051101079404646","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"schrödingers dumbass","id":"264570136025890816","is_bot":0,"username":"greylikessharks"},"author_id":"264570136025890816","channel_id":"739055666651463691","content":"“Nothing good.” They hand him the journal. “Do what you want with it. I hope you choose wisely.”","created_at":"2020-08-06T21:54:48.991000Z","edited_at":null,"id":"741051681696907355","reply_to_id":null,"thread":null,"thread_id":null}
