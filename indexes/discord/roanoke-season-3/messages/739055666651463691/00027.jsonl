{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"739055666651463691","content":"\"No. It really doesn't.\"","created_at":"2020-08-19T17:31:57.319000Z","edited_at":null,"id":"745696572762751090","reply_to_id":null,"thread":null,"thread_id":null}
