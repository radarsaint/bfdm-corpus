{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"739055666651463691","content":"\"Thats ok, you will be. When it gets down to the last hour and everyone puts away their differences. You will find that every one will fight shoulder to should against what's coming despite wha ever may be happenin.\"","created_at":"2020-08-19T16:53:02.041000Z","edited_at":null,"id":"745686777896894492","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"739055666651463691","content":"\"Some of you have accepted it i imagine. And others are still trying to cling to today despite tomorrow.\"","created_at":"2020-08-19T16:54:02.770000Z","edited_at":null,"id":"745687032613044347","reply_to_id":null,"thread":null,"thread_id":null}
