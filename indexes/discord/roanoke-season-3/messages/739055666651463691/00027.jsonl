{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"739055666651463691","content":"\"You have a united cause. But a united plan? What did you have in mind exactly?\"","created_at":"2020-08-19T16:55:59.780000Z","edited_at":null,"id":"745687523388555334","reply_to_id":null,"thread":null,"thread_id":null}
