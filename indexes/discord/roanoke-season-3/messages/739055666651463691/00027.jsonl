{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"739055666651463691","content":"\"These eggs are delicious by the way.\"","created_at":"2020-08-19T16:49:25.409000Z","edited_at":null,"id":"745685869276430376","reply_to_id":null,"thread":null,"thread_id":null}
