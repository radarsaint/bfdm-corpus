{"attachments":[],"author":{"display_name":"schrödingers dumbass","id":"264570136025890816","is_bot":0,"username":"greylikessharks"},"author_id":"264570136025890816","channel_id":"739055666651463691","content":"“Once the Hunger is killed, the divinity inside will all be released back into the world.”","created_at":"2020-08-19T17:26:04.348000Z","edited_at":null,"id":"745695092295205045","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"739055666651463691","content":"\"Your not listening Sir Wynne. I'm telling you. The point of our plan is for all of it to cease to be. Not some sort of karmic exchange. Just nothing.\"","created_at":"2020-08-19T17:27:09.665000Z","edited_at":null,"id":"745695366254559312","reply_to_id":null,"thread":null,"thread_id":null}
