{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"636019040174997505","content":"\"Oh, I'll be careful. I'm sure you'd love it. Now, may I ask, what do you do?\"","created_at":"2020-07-25T17:28:42.116000Z","edited_at":null,"id":"736636057382158337","reply_to_id":null,"thread":null,"thread_id":null}
