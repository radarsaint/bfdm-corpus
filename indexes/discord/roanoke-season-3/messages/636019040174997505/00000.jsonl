{"attachments":[],"author":{"display_name":"justjack420","id":"592252026226999306","is_bot":0,"username":"justjack420"},"author_id":"592252026226999306","channel_id":"636019040174997505","content":"\"Eh, s'pose so. Not really in it fer tha coin.\"","created_at":"2020-07-25T17:33:12.020000Z","edited_at":null,"id":"736637189441585172","reply_to_id":null,"thread":null,"thread_id":null}
