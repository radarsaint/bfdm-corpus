{"attachments":[],"author":{"display_name":"Ozen","id":"321508500138360843","is_bot":0,"username":"ozenannwn"},"author_id":"321508500138360843","channel_id":"709304697713852446","content":"||\"Some of the stories I read about in the library are about the same story but they are completely different because of who wrote it. If I knew who was writing the history I may better know the history. It's harder than transcribing spells written by another sometimes...\"||","created_at":"2020-08-20T17:35:28.924000Z","edited_at":null,"id":"746059848164311090","reply_to_id":null,"thread":null,"thread_id":null}
