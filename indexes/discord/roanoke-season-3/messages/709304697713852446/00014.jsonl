{"attachments":[],"author":{"display_name":"Ozen","id":"321508500138360843","is_bot":0,"username":"ozenannwn"},"author_id":"321508500138360843","channel_id":"709304697713852446","content":"||\"I hope they take some of their goblin-anity with them...\"||","created_at":"2020-08-20T19:59:23.036000Z","edited_at":null,"id":"746096062254678067","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"709304697713852446","content":"\"All people have good and evil within them.  Often you just have to pull the right strings to bring out the best in someone.  Therefore, no one is truly evil, and this I would never ask a goblin to be anything other than a goblin.  All I would do is try to help them find the best of who they are to be\"","created_at":"2020-08-20T20:01:19.526000Z","edited_at":null,"id":"746096550849282189","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Ozen","id":"321508500138360843","is_bot":0,"username":"ozenannwn"},"author_id":"321508500138360843","channel_id":"709304697713852446","content":"||\"I think I was a good deer but if I did that here I would not be as good of a friend. Different kinds of good I suppose.\"||","created_at":"2020-08-20T20:02:57.073000Z","edited_at":null,"id":"746096959990923284","reply_to_id":null,"thread":null,"thread_id":null}
