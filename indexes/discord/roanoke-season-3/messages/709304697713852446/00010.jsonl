{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"709304697713852446","content":"\"Your husbands a warforged. And a knight. Your a girl on the short side with a penchant for plants. We can state facts all we want love. But you would a no be up at night to talk with me in this hovel (no offense heki its a literal ruin) unless you were feeling it a bit weighty.\"","created_at":"2020-08-19T09:18:52.201000Z","edited_at":null,"id":"745572483784245259","reply_to_id":null,"thread":null,"thread_id":null}
