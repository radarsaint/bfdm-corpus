{"attachments":[],"author":{"display_name":"that person logan","id":"519566652824616973","is_bot":0,"username":"thatpersonlogan"},"author_id":"519566652824616973","channel_id":"738994547635519488","content":"“Did I?”","created_at":"2020-08-05T00:40:36.132000Z","edited_at":null,"id":"740368627299254334","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"738994547635519488","content":"\"No, Wren. Please, do not blame yourself. They had a harrowed past.\"","created_at":"2020-08-05T00:41:10.861000Z","edited_at":null,"id":"740368772962975755","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"738994547635519488","content":"\"It isn't my fault or yours. The blame lies solely on Arc.\"","created_at":"2020-08-05T00:41:45.683000Z","edited_at":null,"id":"740368919017291778","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"that person logan","id":"519566652824616973","is_bot":0,"username":"thatpersonlogan"},"author_id":"519566652824616973","channel_id":"738994547635519488","content":"“A harrowed past doesn’t mean there needs to be more pain.”","created_at":"2020-08-05T00:42:28.748000Z","edited_at":null,"id":"740369099644731462","reply_to_id":null,"thread":null,"thread_id":null}
