{"attachments":[],"author":{"display_name":"that person logan","id":"519566652824616973","is_bot":0,"username":"thatpersonlogan"},"author_id":"519566652824616973","channel_id":"738994547635519488","content":"“They said they would always be here. To help us. To love us.” She glares at a spot on the ground. “Then they left us. After only a few days.”","created_at":"2020-08-05T00:40:08.326000Z","edited_at":null,"id":"740368510672437318","reply_to_id":null,"thread":null,"thread_id":null}
