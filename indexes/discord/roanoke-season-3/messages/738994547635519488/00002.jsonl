{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"738994547635519488","content":"\"I brew potions and concoctions for my business, but I mostly make to order. Having a clinic there would be great and I could be a healer when I'm not working on an order.\"","created_at":"2020-08-03T01:37:16.985000Z","edited_at":null,"id":"739658115779264624","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"lnfinitemoon","id":"511053966763884544","is_bot":0,"username":"huskiefolife"},"author_id":"511053966763884544","channel_id":"738994547635519488","content":"\"Oh thats wonderful. I'm actually an apothecary as well, I've always felt that treating the sick was my calling so I find many ways to help as much as I can.\" He looks over the papers again. \"Yes, this sounds like the gods have brought us together for a reason.\"","created_at":"2020-08-03T01:39:12.330000Z","edited_at":null,"id":"739658599571128473","reply_to_id":null,"thread":null,"thread_id":null}
