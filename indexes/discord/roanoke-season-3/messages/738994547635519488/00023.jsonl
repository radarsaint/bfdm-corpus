{"attachments":[],"author":{"display_name":"DCJJ","id":"629235245291667476","is_bot":0,"username":"dcjj"},"author_id":"629235245291667476","channel_id":"738994547635519488","content":"Copper is rowing the boat gently, “so my friend, what did you wish to speak to me about?”","created_at":"2020-08-10T09:13:58.434000Z","edited_at":null,"id":"742309760845742131","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Mistah Noodles","id":"363458590461132800","is_bot":0,"username":"mistahnoodles"},"author_id":"363458590461132800","channel_id":"738994547635519488","content":"\"Other day. Before hags. Shiny Scales forget much. Then say funny thing. Baeshra want know more.\"","created_at":"2020-08-10T09:14:56.573000Z","edited_at":null,"id":"742310004698382458","reply_to_id":null,"thread":null,"thread_id":null}
