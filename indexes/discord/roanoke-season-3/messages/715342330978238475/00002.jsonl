{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"715342330978238475","content":"\"Oh, you are the same! I think Amara would be pleased to know that.\"","created_at":"2020-07-28T00:03:43.669000Z","edited_at":null,"id":"737460244631781437","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Ozen","id":"321508500138360843","is_bot":0,"username":"ozenannwn"},"author_id":"321508500138360843","channel_id":"715342330978238475","content":"\"It was wordless speech so I didn't notice until they said as such, it is the language I use whenever I do that.\"","created_at":"2020-07-28T00:03:59.595000Z","edited_at":null,"id":"737460311430529124","reply_to_id":null,"thread":null,"thread_id":null}
