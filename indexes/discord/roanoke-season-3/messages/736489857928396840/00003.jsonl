{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"736489857928396840","content":"\"The choice is yours. Bare the burden until we understand it well enough to remove it or be done with it now. Either way, you will suffer. It is not an easy choice. Perhaps you should talk to some of your friends?\"","created_at":"2020-07-29T20:57:54.607000Z","edited_at":null,"id":"738138257807638620","reply_to_id":null,"thread":null,"thread_id":null}
