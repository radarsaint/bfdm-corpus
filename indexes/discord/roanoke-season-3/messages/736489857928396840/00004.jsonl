{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"736489857928396840","content":"\"Wren is a mason too so, we can ask her to be there.\"","created_at":"2020-07-30T06:58:51.799000Z","edited_at":null,"id":"738289492632272959","reply_to_id":null,"thread":null,"thread_id":null}
