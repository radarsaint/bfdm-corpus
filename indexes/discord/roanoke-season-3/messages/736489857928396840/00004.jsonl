{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"736489857928396840","content":"\"I wish she could be there, but I think it's going to be too much for her.\"","created_at":"2020-07-30T07:01:08.374000Z","edited_at":null,"id":"738290065469472831","reply_to_id":null,"thread":null,"thread_id":null}
