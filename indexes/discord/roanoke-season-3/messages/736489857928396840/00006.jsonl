{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"736489857928396840","content":"Web looks at Goanhawe and the archivist each trying to take the blame and shakes their head.","created_at":"2020-07-31T08:28:41.250000Z","edited_at":null,"id":"738674485493760063","reply_to_id":null,"thread":null,"thread_id":null}
