{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"736489857928396840","content":"Web looks back to Baeshra and continues the dance","created_at":"2020-07-31T08:35:06.725000Z","edited_at":null,"id":"738676102293356585","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"736489857928396840","content":"\"I thought I understood when you spared my life. The Golden Dawn are powerful when they can use death and despair to motivate and control. The only thing that can protect from that is the pure intention to do good.\"","created_at":"2020-07-31T08:36:10.764000Z","edited_at":null,"id":"738676370892128277","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"736489857928396840","content":"\"Is that your intention?\"","created_at":"2020-07-31T08:36:39.759000Z","edited_at":null,"id":"738676492506234979","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"bobicus","id":"185916549066915852","is_bot":0,"username":"bobicus"},"author_id":"185916549066915852","channel_id":"736489857928396840","content":"\"I have set my intention not to harm another. No threats from the head of my order can deter me, to my own life or to another's.\"","created_at":"2020-07-31T08:36:51.154000Z","edited_at":null,"id":"738676540300328971","reply_to_id":null,"thread":null,"thread_id":null}
