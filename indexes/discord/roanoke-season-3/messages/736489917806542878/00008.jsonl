{"attachments":[],"author":{"display_name":"Basil","id":"339235123759153162","is_bot":0,"username":"divinedefault"},"author_id":"339235123759153162","channel_id":"736489917806542878","content":"\"You don't understand that it's better to recognize you're powerless to change events than to fool yourseld into thinking you're the answer. Tell me, what would you have done? They even said to themselves, it was just thinking aloud.\"","created_at":"2020-07-27T15:26:13.025000Z","edited_at":null,"id":"737330008791580752","reply_to_id":null,"thread":null,"thread_id":null}
