{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"736489917806542878","content":"\"I have watched from afar, these past months, to gain a further understanding of your ideals. It was time for me to simply ask you of your organization myself. I seek to cure my ignorance on this matter, and as such I freely admit to it.\"","created_at":"2020-07-26T23:26:20.520000Z","edited_at":null,"id":"737088448317489262","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"736489917806542878","content":"He smiles","created_at":"2020-07-26T23:27:10.957000Z","edited_at":null,"id":"737088659865600080","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"736489917806542878","content":"\"We are an order born anew, believing that by upholding a divine oath and acting with selflessness in the spirit of good that we may maintain the balance of divinity for all\"","created_at":"2020-07-26T23:30:29.802000Z","edited_at":null,"id":"737089493881847868","reply_to_id":null,"thread":null,"thread_id":null}
