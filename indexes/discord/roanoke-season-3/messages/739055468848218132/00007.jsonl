{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"739055468848218132","content":"“Still, please don’t tell me I’ve gone and built a telescope on sacred grounds...”","created_at":"2020-08-02T03:38:45.480000Z","edited_at":null,"id":"739326298077265943","reply_to_id":null,"thread":null,"thread_id":null}
