{"attachments":[],"author":{"display_name":"Basil","id":"339235123759153162","is_bot":0,"username":"divinedefault"},"author_id":"339235123759153162","channel_id":"739055468848218132","content":"\"Hardly, most of your ilk, no offense to anyone present yet, just bring ships or wash up like you all did. Lot's of them just see us as sporting animals, but those are the most fun.\"","created_at":"2020-08-02T03:34:42.502000Z","edited_at":"2020-08-02T03:34:56.847000Z","id":"739325278953930772","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"schrödingers dumbass","id":"264570136025890816","is_bot":0,"username":"greylikessharks"},"author_id":"264570136025890816","channel_id":"739055468848218132","content":"Wynne kind of tunes out the conversation, zoning out.","created_at":"2020-08-02T03:34:48.359000Z","edited_at":null,"id":"739325303519838299","reply_to_id":null,"thread":null,"thread_id":null}
