{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"739055468848218132","content":"“I’m sorry. I’m not... trespassing..?”","created_at":"2020-08-02T03:36:12.889000Z","edited_at":null,"id":"739325658064486491","reply_to_id":null,"thread":null,"thread_id":null}
