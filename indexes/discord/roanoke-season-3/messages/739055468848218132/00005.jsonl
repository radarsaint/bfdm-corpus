{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"739055468848218132","content":"Web walks off, mingling at the party","created_at":"2020-08-02T01:16:16.581000Z","edited_at":null,"id":"739290441396125736","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739055468848218132","content":"\"Don't put too much on her. She is so young. She shouldn't need to feel as though she is failing her friends. She is strong, but more importantly she needs to have fun. She needs time to be a kid and not worry. Don't push her too hard, love and care for her as I do.\"","created_at":"2020-08-02T01:17:20.563000Z","edited_at":"2020-08-02T01:17:32.903000Z","id":"739290709756215317","reply_to_id":null,"thread":null,"thread_id":null}
