{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"733827764133822465","content":"All are welcome to speak in their time.","created_at":"2020-08-04T03:22:10.295000Z","edited_at":null,"id":"740046899700170822","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"733827764133822465","content":"\"Sir, Baeshra was important to us all. She was a cornerstone to our community. Always caring, always adventurous, always loving. She was learning our society and teaching us about her traditions. She was a noble hunter who never did it for sport, and never ate from those who did not have a fighting chance. She was a lovely cook. Always wanted to find something different to create. Without her, life will never be the same. I worry for my daughter, and how she will react to this news. Please we care so much about her, I think she was the best in our tribe.\"","created_at":"2020-08-04T03:22:13.483000Z","edited_at":null,"id":"740046913071743049","reply_to_id":null,"thread":null,"thread_id":null}
