{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"733827764133822465","content":"\"Terrible beastie.\" He waves a goo arm at web.","created_at":"2020-08-20T20:54:31.791000Z","edited_at":null,"id":"746109940178878514","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"733827764133822465","content":"Web nods. \"Took away my brother. All memories of him are new ones.\"","created_at":"2020-08-20T20:55:36.118000Z","edited_at":null,"id":"746110209986134147","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"733827764133822465","content":"\"Took the name of my daugter. Its been missing for a few hundred years. I just learned again.\"","created_at":"2020-08-20T20:56:22.274000Z","edited_at":null,"id":"746110403578429480","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"733827764133822465","content":"He smiles sadly.","created_at":"2020-08-20T20:56:36.168000Z","edited_at":null,"id":"746110461854089236","reply_to_id":null,"thread":null,"thread_id":null}
