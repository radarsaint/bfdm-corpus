{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"733827764133822465","content":"\"Better to use in concert with Knight's plan, or for something else important if plan works? Could have in reserve if needed for fight, but also use for another work? Just thinking aloud, really.\"","created_at":"2020-08-20T20:13:13.715000Z","edited_at":null,"id":"746099546374930592","reply_to_id":null,"thread":null,"thread_id":null}
