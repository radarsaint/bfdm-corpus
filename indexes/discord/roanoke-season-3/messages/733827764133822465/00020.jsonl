{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"733827764133822465","content":"\"This simple decision has already cost you many lives. In london. On the crossing, all of the sabotage was born of this.\"","created_at":"2020-08-17T01:14:35.582000Z","edited_at":null,"id":"744725835759484978","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Basil","id":"339235123759153162","is_bot":0,"username":"divinedefault"},"author_id":"339235123759153162","channel_id":"733827764133822465","content":"\"Hiram, though i still have much to learn about the masons, rest assured that if your heart is set on your goal your feet will carry you back home. You have struggled with this long enough, no matter the outcome you will be home friend.\"","created_at":"2020-08-17T01:16:19.005000Z","edited_at":null,"id":"744726269547249756","reply_to_id":null,"thread":null,"thread_id":null}
