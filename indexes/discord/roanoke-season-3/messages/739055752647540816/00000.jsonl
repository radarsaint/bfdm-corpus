{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"739055752647540816","content":"Rockman smiles \"I am fine now... Thank you.\" He sits there looking at Leaf. \"As soon as we were attacked, we panicked. In the long run it wasnt our friends to begin with.\"","created_at":"2020-08-08T07:26:11.642000Z","edited_at":null,"id":"741557861422858270","reply_to_id":null,"thread":null,"thread_id":null}
