{"attachments":[],"author":{"display_name":"that person logan","id":"519566652824616973","is_bot":0,"username":"thatpersonlogan"},"author_id":"519566652824616973","channel_id":"739055402120904784","content":"“It’s alright. Skitter, like Selene said, she knew how to be me. It’s not your fault.”","created_at":"2020-08-08T17:11:36.896000Z","edited_at":null,"id":"741705187416211477","reply_to_id":null,"thread":null,"thread_id":null}
