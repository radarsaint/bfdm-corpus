{"attachments":[],"author":{"display_name":"Ozen","id":"321508500138360843","is_bot":0,"username":"ozenannwn"},"author_id":"321508500138360843","channel_id":"739055402120904784","content":"Selene contemplates whether they can make it to the ladder unnoticed before hearing the last three words and visibly relaxing","created_at":"2020-08-09T05:27:28.069000Z","edited_at":null,"id":"741890370857730098","reply_to_id":null,"thread":null,"thread_id":null}
