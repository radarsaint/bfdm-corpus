{"attachments":[],"author":{"display_name":"Deleted User","id":"456226577798135808","is_bot":0,"username":"Deleted User"},"author_id":"456226577798135808","channel_id":"733827832635195424","content":"Rockman pulls her up, he holds her tightly.","created_at":"2020-08-20T08:27:57.917000Z","edited_at":null,"id":"745922061054115881","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Sketchy Bee 🐝","id":"297577343554158603","is_bot":0,"username":"sketchybee"},"author_id":"297577343554158603","channel_id":"733827832635195424","content":"||\"I love you.\"|| Her voice sounds scratchy, tears start to well up in her eyes again.","created_at":"2020-08-20T08:30:02.280000Z","edited_at":null,"id":"745922582670213211","reply_to_id":null,"thread":null,"thread_id":null}
