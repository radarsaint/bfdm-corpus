{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"734864101892685976","content":"\"Where he was created to be\"","created_at":"2020-07-23T21:21:03.272000Z","edited_at":null,"id":"735969755097464954","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"734864101892685976","content":"\"Can you be perfectly sure? My questions are more in the vein of professional curiosity than those of the others gathered here. Can you give me your word as a necromancer that they will be happy here, for the entire duration of their unlife?\"","created_at":"2020-07-23T21:22:10.293000Z","edited_at":null,"id":"735970036203913309","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"734864101892685976","content":"\"I cannot promise that the Mausoluem will not be attacked, nor that there will not be suffering in defense of ze living. But to the best of my ability, yes. They will be happier here then they could possibly be elsewhere.\"","created_at":"2020-07-23T21:24:10.295000Z","edited_at":"2020-07-23T21:24:19.203000Z","id":"735970539528781934","reply_to_id":null,"thread":null,"thread_id":null}
