{"attachments":[],"author":{"display_name":"mazie","id":"366565198284324868","is_bot":0,"username":"damnzam"},"author_id":"366565198284324868","channel_id":"739055626742661130","content":"\"It is mine, technically.\" She takes it from Castor.","created_at":"2020-08-02T02:42:04.804000Z","edited_at":null,"id":"739312034608316558","reply_to_id":null,"thread":null,"thread_id":null}
