{"attachments":[],"author":{"display_name":"BenevolentDM","id":"470420431841656833","is_bot":0,"username":"benevolentdm"},"author_id":"470420431841656833","channel_id":"739240413269065890","content":"Question for <@360967589511561218>. \nCan I use labor, without forming a prior arrangment with a merchant, and then deliver the raw materials produced once I've found someone who needs them?","created_at":"2020-08-02T17:32:58.487000Z","edited_at":null,"id":"739536235605000334","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"739240413269065890","content":"Unfortunately no. You will have to allocate your crafting to a merchant ahead of time in order to produce something","created_at":"2020-08-02T17:34:50.215000Z","edited_at":null,"id":"739536704226066493","reply_to_id":null,"thread":null,"thread_id":null}
