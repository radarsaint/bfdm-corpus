{"attachments":[],"author":{"display_name":"hekiryuu","id":"237577351532249110","is_bot":0,"username":"hekiryuu"},"author_id":"237577351532249110","channel_id":"739546506184491089","content":"\"One the Archvist warned me when I met him.... If I continued to put off.... would kill me...  I tend to believe he was true about that\"","created_at":"2020-08-10T19:53:06.602000Z","edited_at":null,"id":"742470604719915111","reply_to_id":null,"thread":null,"thread_id":null}
