{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"739546506184491089","content":"\"Perhaps however, with the flooding, there is a chance to visit the grounds soon?\"","created_at":"2020-08-10T19:57:18.123000Z","edited_at":null,"id":"742471659675582504","reply_to_id":null,"thread":null,"thread_id":null}
