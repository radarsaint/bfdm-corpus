{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"739546506184491089","content":"\"An instinctive calling... I had something similar, not the same of course, but even when I tried to escape the world I had lived in to travel, it always led me back to a single place that I needed to answer\"","created_at":"2020-08-10T19:56:41.712000Z","edited_at":null,"id":"742471506956779695","reply_to_id":null,"thread":null,"thread_id":null}
