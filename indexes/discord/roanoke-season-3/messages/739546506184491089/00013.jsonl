{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"739546506184491089","content":"\"Hmmmm I hope we can find the location before hand. I was wondering if you could tell me about your form from last night?\"","created_at":"2020-08-10T21:36:34.382000Z","edited_at":null,"id":"742496642036662372","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739546506184491089","content":"\"I think someone has a spell scroll for the spell Commune.\" She pauses. \"If I had it, we could probably get some real answers.\"","created_at":"2020-08-10T21:37:00.834000Z","edited_at":null,"id":"742496752984260669","reply_to_id":null,"thread":null,"thread_id":null}
