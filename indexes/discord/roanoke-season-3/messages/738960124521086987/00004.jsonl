{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"738960124521086987","content":"They pull out their *telescope*.","created_at":"2020-08-01T05:03:34.245000Z","edited_at":null,"id":"738985254039191612","reply_to_id":null,"thread":null,"thread_id":null}
