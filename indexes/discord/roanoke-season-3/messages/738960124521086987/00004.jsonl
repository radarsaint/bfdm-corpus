{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"738960124521086987","content":"\"It's called a *telescope*. My old mentor, Galileo, helped me make it. Here,\" They point it at the sky, finding the moon's surface, at the exact same spot he saw last time.","created_at":"2020-08-01T05:05:22.220000Z","edited_at":null,"id":"738985706919166109","reply_to_id":null,"thread":null,"thread_id":null}
