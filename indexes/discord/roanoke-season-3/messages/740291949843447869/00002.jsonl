{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"740291949843447869","content":"They pull apart. \"Anything else?\"","created_at":"2020-08-07T10:35:40.472000Z","edited_at":null,"id":"741243157886533632","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Sketchy Bee 🐝","id":"297577343554158603","is_bot":0,"username":"sketchybee"},"author_id":"297577343554158603","channel_id":"740291949843447869","content":"\"Not right now, no. It's late and I didn't get good sleep last night, so maybe later. But for now I know enough.\" Leaf beams, feeling much lighter than before.\n(wouldn't be surprised if I'm forgetting things but it's almost 4 am so eh)","created_at":"2020-08-07T10:40:18.660000Z","edited_at":null,"id":"741244324691443793","reply_to_id":null,"thread":null,"thread_id":null}
