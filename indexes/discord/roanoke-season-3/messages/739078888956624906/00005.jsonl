{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"739078888956624906","content":"\"The symbols that were on the hanging tree and the masonic stone beneath it were chiseled by a Mason. It is a desire they 'Ave always had to build and repair\"","created_at":"2020-08-13T08:34:59.391000Z","edited_at":null,"id":"743387113785131008","reply_to_id":null,"thread":null,"thread_id":null}
