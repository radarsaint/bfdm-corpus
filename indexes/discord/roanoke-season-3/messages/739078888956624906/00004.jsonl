{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"739078888956624906","content":"Web nods to him. \"You can help them see greatness already there. We all can. Web is mason, Web don't know Knight secrets. But Web know they will return to their courage. They are strong.\"","created_at":"2020-08-13T07:16:03.544000Z","edited_at":null,"id":"743367250202984449","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"739078888956624906","content":"\"It is on them to pursue that path now. I will hold my faith out for their return\"","created_at":"2020-08-13T07:19:39.763000Z","edited_at":null,"id":"743368157091332177","reply_to_id":null,"thread":null,"thread_id":null}
