{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"739078888956624906","content":"(Hey he's tired *and* undiplomatic)","created_at":"2020-08-05T06:57:28.924000Z","edited_at":null,"id":"740463472223191080","reply_to_id":null,"thread":null,"thread_id":null}
