{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"736692284057190430","content":"\"Zee ship is quite capable, people tend to think of leylines as straight, but in truth the bend and zig zag like lightning or perhaps like a tectonic plate.\"","created_at":"2020-07-26T05:49:13.462000Z","edited_at":null,"id":"736822415954411532","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"736692284057190430","content":"\"The slow speed is not a matter of horse power. She can do well over 60 knotts\"","created_at":"2020-07-26T05:49:43.699000Z","edited_at":"2020-07-26T05:49:49.361000Z","id":"736822542777450566","reply_to_id":null,"thread":null,"thread_id":null}
