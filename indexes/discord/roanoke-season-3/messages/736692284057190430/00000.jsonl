{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"736692284057190430","content":"“Right, but astral-tethered blinkjumping would allow you to travel faster and avoid a lot of obstacles... plus, this thing could go anywhere at that point...”","created_at":"2020-07-26T05:48:03.002000Z","edited_at":null,"id":"736822120423751700","reply_to_id":null,"thread":null,"thread_id":null}
