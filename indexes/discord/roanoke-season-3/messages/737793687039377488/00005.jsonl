{"attachments":[],"author":{"display_name":"Orxta","id":"343605682580488215","is_bot":0,"username":"robdor."},"author_id":"343605682580488215","channel_id":"737793687039377488","content":"\"The task of choosing a mayor will fall to the aristocracy. There is talk of merchants seeking to make a bid for the position. There are even rumors of serfs trying to take on that role.\"","created_at":"2020-07-29T03:07:56.888000Z","edited_at":null,"id":"737868993058177146","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Orxta","id":"343605682580488215","is_bot":0,"username":"robdor."},"author_id":"343605682580488215","channel_id":"737793687039377488","content":"\"I'm sure I dont' need to tell you what a disaster that would be.\"","created_at":"2020-07-29T03:08:15.339000Z","edited_at":null,"id":"737869070447149176","reply_to_id":null,"thread":null,"thread_id":null}
