{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"We will sponsor you\"","created_at":"2020-07-18T23:44:22.730000Z","edited_at":null,"id":"734193884510421022","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"lnfinitemoon","id":"511053966763884544","is_bot":0,"username":"huskiefolife"},"author_id":"511053966763884544","channel_id":"636017039126954024","content":"\"Of course Sir Chapelle. And his has been a dream of mine to travel to the new world, to help build for the future. Im honored.\"","created_at":"2020-07-18T23:45:13.779000Z","edited_at":null,"id":"734194098625445928","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"Sil vous plaite, call me Florian\"","created_at":"2020-07-18T23:45:43.710000Z","edited_at":null,"id":"734194224165158972","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"lnfinitemoon","id":"511053966763884544","is_bot":0,"username":"huskiefolife"},"author_id":"511053966763884544","channel_id":"636017039126954024","content":"\"Alright, Florian.\" \"What is there to do around the château? I'm a skilled apothecary as well.\"","created_at":"2020-07-18T23:48:59.812000Z","edited_at":null,"id":"734195046676693133","reply_to_id":null,"thread":null,"thread_id":null}
