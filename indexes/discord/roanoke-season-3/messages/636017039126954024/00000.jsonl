{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"Also, another task. Seek out others that may be interested. If their heart is pure they may join us. I imagine there's quite an adventure ahead of us mon amis\"","created_at":"2020-07-18T23:56:28.121000Z","edited_at":null,"id":"734196927020793886","reply_to_id":null,"thread":null,"thread_id":null}
