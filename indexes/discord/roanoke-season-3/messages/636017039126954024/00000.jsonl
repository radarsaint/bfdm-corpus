{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"You will be called upon in times of need, whether to defend others, or to go out on your odyssey. But for now, you can help our Knights at breakfast pass out food for the need, du martin\"","created_at":"2020-07-18T23:43:10.481000Z","edited_at":"2020-07-18T23:43:17.015000Z","id":"734193581476282409","reply_to_id":null,"thread":null,"thread_id":null}
