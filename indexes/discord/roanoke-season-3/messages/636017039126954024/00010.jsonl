{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"Right now, I can't say that I know. Daysong is a friend of mine, but I do not know of their intentions involving the Hunger\"","created_at":"2020-07-22T02:38:20.148000Z","edited_at":null,"id":"735324825811157002","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"And Kairo, he is a wild soul that I appreciate. However if he has any deceitful intentions, I would know none the better\"","created_at":"2020-07-22T02:39:27.134000Z","edited_at":null,"id":"735325106770804806","reply_to_id":null,"thread":null,"thread_id":null}
