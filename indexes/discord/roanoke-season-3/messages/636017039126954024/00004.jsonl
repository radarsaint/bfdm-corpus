{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"You are welcome to ask questions if you have any. I will be happy to do what I can to answer them.\"","created_at":"2020-07-20T17:39:09.818000Z","edited_at":null,"id":"734826750827298998","reply_to_id":null,"thread":null,"thread_id":null}
