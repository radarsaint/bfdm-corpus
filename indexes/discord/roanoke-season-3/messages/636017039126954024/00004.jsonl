{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"I am glad this does so. There are many people in great need with the absence of divine warmth. I have faith that one day people like us can find a way to bring it back\"","created_at":"2020-07-20T18:01:47.892000Z","edited_at":null,"id":"734832447002247228","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"\"If you believe that your heart should be tested for our cause, you but only need to ask\"","created_at":"2020-07-20T18:02:21.004000Z","edited_at":null,"id":"734832585884172464","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"BaronofFircrest","id":"456542272373391362","is_bot":0,"username":"baronoffircrest"},"author_id":"456542272373391362","channel_id":"636017039126954024","content":"\"I do choose to be tested. This is a path that calls to me after so much time wandering without one.\"","created_at":"2020-07-20T18:03:58.394000Z","edited_at":null,"id":"734832994367438952","reply_to_id":null,"thread":null,"thread_id":null}
