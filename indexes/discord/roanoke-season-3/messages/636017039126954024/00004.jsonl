{"attachments":[],"author":{"display_name":"lnfinitemoon","id":"511053966763884544","is_bot":0,"username":"huskiefolife"},"author_id":"511053966763884544","channel_id":"636017039126954024","content":"\"I came to speak to Florian about armor and silvering? And maybe afterwards some training! I've been looking forward to some sparing.\"","created_at":"2020-07-20T17:53:41.620000Z","edited_at":null,"id":"734830407429914666","reply_to_id":null,"thread":null,"thread_id":null}
