{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"The voice of a young woman talks in your mind","created_at":"2020-07-20T18:07:05.398000Z","edited_at":null,"id":"734833778719064075","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Noah","id":"360967589511561218","is_bot":0,"username":"king.crusader"},"author_id":"360967589511561218","channel_id":"636017039126954024","content":"||You come from pain and we're raised in blood. There are many secrets of your people that you may never get to experience. Your heart has experienced a great journey. Your faith in a better tomorrow has potential for great reward to your spiritual being. To help others in their defense is what you have forged yourself to do despite the circumstance of your upbringing. Here there is a family that will grow with you in faith, but the path will be difficult, may bring pain, more so than that which you were raised with. Will you accept?||","created_at":"2020-07-20T18:10:44.573000Z","edited_at":null,"id":"734834698005512214","reply_to_id":null,"thread":null,"thread_id":null}
