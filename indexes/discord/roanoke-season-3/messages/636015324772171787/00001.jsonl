{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"636015324772171787","content":"\"Same as you! Looking forward to the adventure\"","created_at":"2020-07-19T04:34:11.226000Z","edited_at":null,"id":"734266817148747888","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DIS","id":"362408476372369410","is_bot":0,"username":".disassembly"},"author_id":"362408476372369410","channel_id":"636015324772171787","content":"\"Seems ta me there's a good bet of that floatin bout...\" He scrapes the last bits of pie onto his fork and cleans it. \"So, I assume this Auntie lass is the proprietor here?\"","created_at":"2020-07-19T04:36:27.665000Z","edited_at":null,"id":"734267389415522366","reply_to_id":null,"thread":null,"thread_id":null}
