{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"733827237459263519","content":"\"As Chief of the village I must consider all counsel. The departure of Empty hill has brought us relief. But it is only a matter of time before he appoints a new Uru to the village.\"","created_at":"2020-08-15T23:01:47.969000Z","edited_at":null,"id":"744330029302939690","reply_to_id":null,"thread":null,"thread_id":null}
