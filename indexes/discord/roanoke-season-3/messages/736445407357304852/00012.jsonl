{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"736445407357304852","content":"“I didn’t think...”","created_at":"2020-07-31T05:41:13.023000Z","edited_at":null,"id":"738632340175192086","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736445407357304852","content":"\"I almost lost you today. I almost lost my former love. When I realized I could lose someone that loved me so much. I couldn't bear it. This is the first step. Not pity just trying to move further towards the future.\"","created_at":"2020-07-31T05:43:07.614000Z","edited_at":null,"id":"738632820804550766","reply_to_id":null,"thread":null,"thread_id":null}
