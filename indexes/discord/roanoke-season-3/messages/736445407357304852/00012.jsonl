{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736445407357304852","content":"\"And he could have. Without suicide. But here we are.\"","created_at":"2020-07-31T14:37:18.928000Z","edited_at":null,"id":"738767253759328279","reply_to_id":null,"thread":null,"thread_id":null}
