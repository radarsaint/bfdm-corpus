{"attachments":[],"author":{"display_name":"schrödingers dumbass","id":"264570136025890816","is_bot":0,"username":"greylikessharks"},"author_id":"264570136025890816","channel_id":"736445407357304852","content":"They nod, eyes sad. “I know.”","created_at":"2020-07-31T14:32:12.198000Z","edited_at":null,"id":"738765967240331294","reply_to_id":null,"thread":null,"thread_id":null}
