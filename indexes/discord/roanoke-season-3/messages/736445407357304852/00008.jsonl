{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"736445407357304852","content":"\"I...\" Their voice cracks a little","created_at":"2020-07-30T06:54:24.149000Z","edited_at":null,"id":"738288370026938368","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"736445407357304852","content":"\"When we met, I showed you the moon through an invention partially-of-mine called the *telescope*. It makes things look a lot closer than they are. You really liked it and I saw the awe in your eyes and thats when I knew.\"","created_at":"2020-07-30T06:55:40.682000Z","edited_at":null,"id":"738288691029606411","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"736445407357304852","content":"\"We're underwater now so I can't show you any more but when we land I promise you I will show you the moon again.\"","created_at":"2020-07-30T06:56:12.288000Z","edited_at":null,"id":"738288823594909696","reply_to_id":null,"thread":null,"thread_id":null}
