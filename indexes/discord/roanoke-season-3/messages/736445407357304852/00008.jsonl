{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"736445407357304852","content":"\"No, Cato. You were the love of my life and now you're colder than ever before.\" Tears well up in their eyes.","created_at":"2020-07-30T06:59:29.439000Z","edited_at":null,"id":"738289650506006579","reply_to_id":null,"thread":null,"thread_id":null}
