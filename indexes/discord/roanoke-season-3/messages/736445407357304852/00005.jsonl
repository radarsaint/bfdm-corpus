{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736445407357304852","content":"Cato enters. Grimm and silent","created_at":"2020-07-28T06:57:16.127000Z","edited_at":null,"id":"737564315623882754","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"736445407357304852","content":"“Cato. I’m sorry. I have shit you out this past while. I will explain. I was rash, and I beg of you to forgive me, but I do not regret it nor would I refrain from similar action in the future.”","created_at":"2020-07-28T06:58:57.203000Z","edited_at":null,"id":"737564739567091784","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736445407357304852","content":"He winces at the final statement","created_at":"2020-07-28T06:59:32.739000Z","edited_at":null,"id":"737564888616009730","reply_to_id":null,"thread":null,"thread_id":null}
