{"attachments":[],"author":{"display_name":"izar","id":"566079740591603714","is_bot":0,"username":"izarsystem"},"author_id":"566079740591603714","channel_id":"736445407357304852","content":"“Thank you. Have you thought at all about a name and title?”","created_at":"2020-07-26T15:58:16.874000Z","edited_at":null,"id":"736975690133667850","reply_to_id":null,"thread":null,"thread_id":null}
