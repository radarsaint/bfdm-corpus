{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736445407357304852","content":"\"Well, there you have it ♪\"","created_at":"2020-07-31T23:32:51.392000Z","edited_at":null,"id":"738902027081613472","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736445407357304852","content":"\"After I found Elith like that I vowed to never let someone die again.\"","created_at":"2020-07-31T23:33:24.503000Z","edited_at":null,"id":"738902165958950933","reply_to_id":null,"thread":null,"thread_id":null}
