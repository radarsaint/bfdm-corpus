{"attachments":[],"author":{"display_name":"Aerith","id":"260949833773219840","is_bot":0,"username":"aerith_of_aer"},"author_id":"260949833773219840","channel_id":"736445407357304852","content":"\"No, but we have the koi god. He was caring for it when I entered.\"","created_at":"2020-07-30T02:54:06.884000Z","edited_at":null,"id":"738227899634679808","reply_to_id":null,"thread":null,"thread_id":null}
