{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"738988904308408340","content":"\"The Tatankans are grateful. But we also come with many questions.\"","created_at":"2020-08-14T18:41:03.770000Z","edited_at":null,"id":"743902024911028275","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DCJJ","id":"629235245291667476","is_bot":0,"username":"dcjj"},"author_id":"629235245291667476","channel_id":"738988904308408340","content":"Copper nods, “I’m happy to hear some of my people were able to assist you. Any questions you may have, I will answer them to the best of my abilities.”","created_at":"2020-08-14T18:43:26.897000Z","edited_at":null,"id":"743902625228914849","reply_to_id":null,"thread":null,"thread_id":null}
