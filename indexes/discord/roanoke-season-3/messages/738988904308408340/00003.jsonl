{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"738988904308408340","content":"\"Greetings. Neighbors. I am Thunderstruck. Chief of the Tatankans.\" He speaks slowly and deliberately. With him are two other Tatankan. \"This is Clover and Betsy. My two daughters and wisewomen of the the Pen.\"","created_at":"2020-08-14T18:34:27.516000Z","edited_at":"2020-08-14T18:34:56.153000Z","id":"743900362901291090","reply_to_id":null,"thread":null,"thread_id":null}
