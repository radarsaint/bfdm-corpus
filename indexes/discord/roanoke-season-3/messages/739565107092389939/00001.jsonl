{"attachments":[],"author":{"display_name":"nut_wizard","id":"594008151779573762","is_bot":0,"username":"nut_wizard"},"author_id":"594008151779573762","channel_id":"739565107092389939","content":"“So you... collect stuff, and remember... other stuff?”","created_at":"2020-08-05T00:42:11.755000Z","edited_at":null,"id":"740369028371185666","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739565107092389939","content":"She nods \"It might seem silly, but it helps me remember things. Especially those who have passed on.\"","created_at":"2020-08-05T00:44:01.264000Z","edited_at":null,"id":"740369487685091409","reply_to_id":null,"thread":null,"thread_id":null}
