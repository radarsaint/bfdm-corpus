{"attachments":[],"author":{"display_name":"nut_wizard","id":"594008151779573762","is_bot":0,"username":"nut_wizard"},"author_id":"594008151779573762","channel_id":"739565107092389939","content":"He nods once.","created_at":"2020-08-05T00:28:07.348000Z","edited_at":null,"id":"740365486671527968","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739565107092389939","content":"\"Well..\" She thinks for a moment. \"She is mostly known as the goddess of death, and because of that many fear her. However, she doesn't bring death more understands it. But like death she also understands life and it's want to thrive.\"","created_at":"2020-08-05T00:30:44.277000Z","edited_at":null,"id":"740366144879460402","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739565107092389939","content":"\"She watches, and collects and scavenges for followers from events that bring death, she helped me survive on this island for example. Her fondness for memories is how she understands things, she has the ability to collect memories from those who have passed and can watch them.\"","created_at":"2020-08-05T00:34:31.617000Z","edited_at":null,"id":"740367098412269580","reply_to_id":null,"thread":null,"thread_id":null}
