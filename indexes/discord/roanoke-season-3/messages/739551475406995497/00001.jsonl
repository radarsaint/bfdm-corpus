{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"739551475406995497","content":"\"Nothing I can do but rewrap the wounds. They'll be there tomorrow, when we travel, when we fight.\"","created_at":"2020-08-10T10:27:40.941000Z","edited_at":null,"id":"742328310184542258","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739551475406995497","content":"\"And yet you still fight. I would call you mad, but if my theory is correct and the Raven Queen is using you I don't think I should.\"","created_at":"2020-08-10T10:29:08.968000Z","edited_at":null,"id":"742328679396540446","reply_to_id":null,"thread":null,"thread_id":null}
