{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739551475406995497","content":"\"Perhaps. But I would still like to try.\"","created_at":"2020-08-10T10:26:16.222000Z","edited_at":null,"id":"742327954847039500","reply_to_id":null,"thread":null,"thread_id":null}
