{"attachments":[],"author":{"display_name":"Nobleindie","id":"361351593292988425","is_bot":0,"username":"nobleindie"},"author_id":"361351593292988425","channel_id":"739551475406995497","content":"Lilia raises her glass. \"May the Raven Queens motives soon be clear to us.\"","created_at":"2020-08-10T10:22:59.105000Z","edited_at":null,"id":"742327128078549092","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"739551475406995497","content":"\"And may her swords sing quietly\"","created_at":"2020-08-10T10:23:19.033000Z","edited_at":"2020-08-10T10:23:29.049000Z","id":"742327211662770189","reply_to_id":null,"thread":null,"thread_id":null}
