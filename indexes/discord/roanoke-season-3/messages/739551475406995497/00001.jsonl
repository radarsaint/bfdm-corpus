{"attachments":[],"author":{"display_name":"Devloot","id":"246711433730064384","is_bot":0,"username":"devon8642"},"author_id":"246711433730064384","channel_id":"739551475406995497","content":"Rigatony shrugs \"Not even you, my Lady, can sew some wounds closed, but by all means I wish you luck in trying\"","created_at":"2020-08-10T10:25:33.126000Z","edited_at":null,"id":"742327774089314325","reply_to_id":null,"thread":null,"thread_id":null}
