{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"638590342005784588","content":"\"The Urucokra are wise, and find their roots in Oro's Kingdom. Though their wisdom on the island seems to have been replaced with brute strength.\"","created_at":"2020-08-11T23:55:03.226000Z","edited_at":null,"id":"742893879719624756","reply_to_id":null,"thread":null,"thread_id":null}
