{"attachments":[],"author":{"display_name":"D (they/them)","id":"692746345387130900","is_bot":0,"username":"nonbianarydarry"},"author_id":"692746345387130900","channel_id":"638590342005784588","content":"Skitter nods.","created_at":"2020-08-11T23:50:15.628000Z","edited_at":null,"id":"742892673446182942","reply_to_id":null,"thread":null,"thread_id":null}
