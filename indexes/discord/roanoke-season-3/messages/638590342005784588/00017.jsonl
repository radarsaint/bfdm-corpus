{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"638590342005784588","content":"\"The Original Tribes of Roanoke Were the Lago and the Wendigo. Long before the Wendigo were corrupted.\"","created_at":"2020-08-11T23:49:42.354000Z","edited_at":null,"id":"742892533884911758","reply_to_id":null,"thread":null,"thread_id":null}
