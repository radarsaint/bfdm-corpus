{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"638590342005784588","content":"\"I don't know.\" He looks worried.","created_at":"2020-07-30T07:47:05.160000Z","edited_at":null,"id":"738301628268150885","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"638590342005784588","content":"\"It looked to be some sort of prison...\"","created_at":"2020-07-30T07:47:37.426000Z","edited_at":null,"id":"738301763601432597","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Eloise >:3c","id":"260820438026813440","is_bot":0,"username":"effervescenteloise"},"author_id":"260820438026813440","channel_id":"638590342005784588","content":"\"Is she in there with Solomon?\"","created_at":"2020-07-30T07:47:47.208000Z","edited_at":null,"id":"738301804630114306","reply_to_id":null,"thread":null,"thread_id":null}
