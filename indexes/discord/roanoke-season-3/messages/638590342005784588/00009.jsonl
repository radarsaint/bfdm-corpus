{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"638590342005784588","content":"\"There is a word. But it can be dangerous to speak it. A name that in Arcania causes all to fear.\"","created_at":"2020-07-30T07:52:48.785000Z","edited_at":null,"id":"738303069535600640","reply_to_id":null,"thread":null,"thread_id":null}
