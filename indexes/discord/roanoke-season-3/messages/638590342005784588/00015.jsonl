{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"638590342005784588","content":"\"Greetings. New. Masons. HHHHHHHHHHH. How can I be of service?\"","created_at":"2020-08-10T19:24:19.961000Z","edited_at":null,"id":"742463362662924428","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"Basil","id":"339235123759153162","is_bot":0,"username":"divinedefault"},"author_id":"339235123759153162","channel_id":"638590342005784588","content":"\"What is our goal as masons? I would like yo know how to aid these people and learn what we as a clan know.\"","created_at":"2020-08-10T19:25:17.051000Z","edited_at":null,"id":"742463602115477674","reply_to_id":null,"thread":null,"thread_id":null}
{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"638590342005784588","content":"\"Information Available: The goal of the Masons while in arcania is two fold. Our publicly stated goal is that as keepers of the Identify spell its is our duty to to to to add the all Arcanian Cryptids to the spell by means of the scrolls left behind my Llewllyn Ap Daysong.\"","created_at":"2020-08-10T19:27:17.733000Z","edited_at":null,"id":"742464108292735057","reply_to_id":null,"thread":null,"thread_id":null}
