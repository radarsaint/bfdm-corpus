{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"638590342005784588","content":"\"Anyone is worthy of my help Web. Anyone. But you have had a special place in my heart from the moment we first met you. It will fix exactly what you asked for. The spell weave was bent to execute your wish.\"","created_at":"2020-07-30T21:50:35.423000Z","edited_at":null,"id":"738513903096430612","reply_to_id":null,"thread":null,"thread_id":null}
