{"attachments":[],"author":{"display_name":"DM radar","id":"313689699627696139","is_bot":0,"username":"bfdm"},"author_id":"313689699627696139","channel_id":"638590342005784588","content":"\"I will be fine web. That is more than just a spell. It is a way to bend the spell weave to my will. I doubt I will ever be able to cast it again.\"","created_at":"2020-07-30T21:45:47.634000Z","edited_at":null,"id":"738512696021876768","reply_to_id":null,"thread":null,"thread_id":null}
